#!/bin/sh
# git's credential helper for https://github.com in gsrpi-dev-base, named `hub` in
# ~/.gitconfig by the entrypoint: answers with the hub's token for this container's repo
# (dev/README.md § "GitHub tokens, one repo each"). Read on each call, so a renewed token is
# used as soon as the hub writes it. With no token it answers nothing, and git asks the next
# helper or fails as it would have. `store` and `erase` are ignored: the hub owns the token.
[ "$1" = get ] || exit 0
cat > /dev/null
[ -s /run/github/token ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat /run/github/token)"
