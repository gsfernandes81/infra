# screen inside any container built on gsrpi-dev-base. The sessions in here are
# detached and re-attached, so what matters is surviving a detach, not looks.

startup_message off
defscrollback 10000        # claude prints long output; the default 100 lines loses it
altscreen on               # restore the shell's screen after a full-screen program exits
vbell off
term xterm-256color

# Detach rather than die if the terminal that was attached goes away — an ssh drop
# from the phone must not take the session with it.
autodetach on

# A status line, because a detached-and-reattached session with no chrome is easy to
# mistake for a plain shell, and then you start a SECOND claude in it. It names the
# container, which matters a great deal now: zero runs several of these and they all
# look alike once you are inside one.
#
# `%H` and not a baked name — this file is in the SHARED base, so a literal would have
# every container calling itself infra-dev. screen expands %H to the hostname, which
# each repo's compose sets to that container's own name.
hardstatus alwayslastline '%{= kG}[ %H ] %{= kw}%-w%{=b kR}[%n %t]%{-}%+w %=%{= kG}%c'
