#!/bin/sh
# Print the version of Crush's latest release — `0.98.1`, no `v` — for the base build's
# CRUSH_VERSION build-arg. Run by .github/workflows/dev-base.yml and by `make base`, the
# two places the base is built, so both ask the same question the same way.
#
# WHY A LOOKUP AT ALL, when the owner asked for the latest and no pin: Docker caches a layer
# by its instruction, so an unpinned `apt-get install crush` would carry the first version
# it ever installed, forever. Resolving the version OUTSIDE the build and passing it in makes
# the Crush layer change exactly when Charm releases — not on every BASE_TAG bump, which
# would make every Pi re-pull ~25 MB of an unchanged Crush. Dockerfile.base, the Crush layer.
#
# GitHub's /releases/latest redirect, not its API: the API allows a runner 60 unauthenticated
# calls an hour across everything sharing its address, the redirect has no such budget, and
# `latest` there already skips pre-releases and drafts. Charm publishes the apt package from
# the same release run, so a version found here is one apt can install; the minutes between
# the two are a failed build that a re-run fixes, not a wrong one.
#
# REFUSES rather than guesses: anything that is not a plain dotted version — a moved repo, a
# changed redirect, an HTML error page — exits 1 and prints nothing on stdout, so a caller
# never passes a half-parsed string to apt.
set -eu
url=https://github.com/charmbracelet/crush/releases/latest
ver="$(curl -fsSI --max-time 30 "$url" \
    | sed -n 's|^[Ll]ocation: .*/releases/tag/v\([0-9][0-9.]*[0-9]\)\r*$|\1|p')"
case "$ver" in
    ''|*[!0-9.]*) echo "crush-latest: no version in the redirect from $url" >&2; exit 1 ;;
esac
echo "$ver"
