#!/bin/sh
# What every ssh session into this container runs: the claude-sessions menu, a forwarded
# command, or a shell.
#
#     ForceCommand /usr/local/bin/claude-sessions-door      (dev/sshd_config)
#
# The contract is claude-sessions' docs/design.md § "The door"; this is infra's half of it.
# It is sshd's ForceCommand since 2026-10-04 (infra#7), so no client names it: a client's
# ssh block is transport only, and `ssh <c>`, `ssh <c> cmd`, scp, sftp and Zed all arrive
# here. Before that it was each client's RemoteCommand, which made `ssh <c> cmd` a
# client-side error and let a client name a door its container's image did not have.
#
# ONLY AN INTERACTIVE LOGIN GETS THE MENU. A full-screen program on the other end of rsync,
# scp or a `ssh box cmd` corrupts the stream or waits forever for a key, so:
#   - a command the client asked for (SSH_ORIGINAL_COMMAND) runs as given, in $HOME where
#     sshd put it — exactly as it ran before the door was forced, so nothing that worked
#     then moves. That includes sftp: dev/sshd_config names a real sftp-server binary
#     for this branch to run, because the `internal-sftp` it used to name is not one.
#     `ssh <c> in-workspace cmd` runs a command in /workspace instead. ONE EXCEPTION: an
#     abduco-era client block's `abduco -A claude claude` (abduco left the image
#     2026-10-06) is caught below and becomes a login — the menu at a terminal;
#   - no terminal on stdin or stdout means a plain login shell;
#   - a terminal and no command is the menu, in /workspace.
#
# THE MENU FAILING MUST NEVER LOCK THE DOOR. Exit 0 is the owner quitting, and ends the
# login. Anything else — the binary missing, a terminal too narrow, a registry it cannot
# read — and claude-sessions has already said why on stderr; this adds one line and becomes
# a login shell, so a broken menu costs a keypress rather than a `docker exec` from the host.
# The one exception is 129 (claude-sessions v0.3.7): the terminal went away and the menu
# said nothing. The line and the shell then meet a hung-up terminal and fail quietly, so
# the door does not special-case it (decisions.md, the door row).
#
# `$SHELL`, never a named shell: infra-dev logs in to fish, dd-dev and dossier to bash, and
# this file is in the base all of them share. sshd sets it; `docker exec` (`make claude`)
# does not, so the account's passwd shell is the next answer and /bin/sh the last.
set -u

shell="${SHELL:-$(getent passwd "$(id -u)" | cut -d: -f7)}"
shell="${shell:-/bin/sh}"

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    # Unset before it runs, or a command that leads back here loops: a client block from
    # before 2026-10-04 still sends `in-workspace claude-sessions-door` as its command,
    # and the door it reaches must see a login, not that same command again.
    cmd=$SSH_ORIGINAL_COMMAND
    unset SSH_ORIGINAL_COMMAND
    case $cmd in
        # A client block from before 2026-10-02 still sends `in-workspace abduco -A claude
        # claude` (the dev block's form) or `abduco -A claude claude` (the older fleet one),
        # and abduco left the image on 2026-10-06 — run as given it is "Unknown command" and
        # the login ends. Say so and give that client what it was asking for: the menu at a
        # terminal. Without one it was a script, which should fail rather than sit at a
        # login shell waiting on stdin, so it gets 127, the shell's "not found".
        "abduco "*|"in-workspace abduco "*)
            echo "claude-sessions-door: this client's ssh block predates 2026-10-02 and abduco is gone; re-run client-home-ssh-config.yml there." >&2
            if [ ! -t 0 ] || [ ! -t 1 ]; then exit 127; fi
            echo "claude-sessions-door: opening the menu instead." >&2
            ;;
        *) exec "$shell" -c "$cmd" ;;
    esac
fi

# Where the work is, for the menu and both shells — what `in-workspace` did when it ran
# ahead of the door. Warn and carry on, as it does: with the bind mount missing you want
# the way in anyway, most likely to find out why.
if ! cd /workspace 2>/dev/null; then
    echo "claude-sessions-door: /workspace is not there - the bind mount is missing; staying in $(pwd)" >&2
fi

if [ ! -t 0 ] || [ ! -t 1 ]; then
    exec "$shell" -l
fi

# THE TRAP IS WHAT KEEPS THE FALLBACK REACHABLE, and it was found in review, not in use.
# /bin/sh here is dash, and a non-interactive dash that receives SIGINT while its
# foreground child runs waits for the child and then kills ITSELF with that signal —
# whatever the child exited with — so a ^C in the menu's start-up window (it reads /proc
# and the registry before it puts the terminal in raw mode) or between a detach and the
# redraw ended the login instead of reaching the shell below. A handler, not `trap ''`: an
# ignored signal is inherited across exec, and the menu, zmx and every claude under it
# would then ignore ^C too. A handler resets to the default in the child, so a ^C still
# stops a menu caught before raw mode — exit 130, and the shell below. bash is no fix
# either: it exits the same way when the child died OF the SIGINT, the common case.
trap : INT
claude-sessions
status=$?
trap - INT
[ "$status" -eq 0 ] && exit 0

echo "claude-sessions-door: the menu exited $status (its reason is above); here is a login shell instead" >&2
exec "$shell" -l
