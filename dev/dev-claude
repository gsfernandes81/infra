#!/bin/sh
# Start or reattach the container's claude session, in the workspace.
#
#     dev-claude            the session called `claude`
#     dev-claude review     a second one, called `review`
#
# THIS EXISTS SO THAT CLIENTS DO NOT HAVE TO KNOW ANY OF IT. It was first written into
# the phone's ssh config as `RemoteCommand cd /workspace 2>/dev/null; abduco -A claude
# claude`, which worked and was in the wrong place: every client that ever connects — a
# laptop, a second phone, a cron — would need the same incantation, and the container
# that owns the answer would not be the thing giving it. A client should say `dev-claude`
# and nothing else.
#
# WHY THE cd IS NEEDED AT ALL. sshd runs a remote command as `$SHELL -c '…'`, which is
# NOT a login shell, so config.fish's `status is-login` guard is false and its cd to
# /workspace never fires. A plain `ssh` with no command gets a login shell and lands
# correctly, which is what makes the symptom confusing: one alias works and the other
# does not, for a reason neither of them mentions.
#
# It is not cosmetic. The entrypoint seeds Claude Code's trust dialog for /workspace, so
# a session started in /home/dev asks you to trust a directory that is not the repo.
#
# Rejected: an sshd ForceCommand that cds every session whatever the client asked for.
# It is the more complete answer and it is not worth it here — it has to special-case
# sftp and $SSH_ORIGINAL_COMMAND, it is boot-path-ish config on the only way in, and
# CLAUDE.md is explicit about care with the thing you are connected through. A wrapper
# is inert until someone runs it.
set -u

if ! cd /workspace 2>/dev/null; then
    # Warn and carry on rather than refuse. If the bind mount is missing you want the
    # session so you can find out why; a client that got nothing at all is worse.
    echo "dev-claude: /workspace is not there — the bind mount is missing." >&2
    echo "dev-claude: starting in $(pwd) instead. Check INFRA_SRC in dev/.env." >&2
fi

# `abduco -A NAME CMD` attaches the session called NAME, creating it if absent — so the
# same command starts the work and comes back to it, and it does not matter which client
# you arrive from. Reattaching ignores the cd above, which is correct: that session has
# its own directory and may well have been moved on purpose.
exec abduco -A "${1:-claude}" claude
