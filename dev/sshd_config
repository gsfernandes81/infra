# In-container sshd, baked into gsrpi-dev-base and shared by every container built on it. Runs
# as the unprivileged `dev` user on port 2222 inside the container. Nothing publishes it: the
# hub reaches each container on the `dev` network with its own key, and the one sshd anything
# else reaches is or3-dev's, through the hub's tunnel, for the phone's reverse forward to the
# vessel LAN (dev/cloudflared.yml).
#
# ONE FILE FOR EVERY CONTAINER, since 2026-10-27. Until then children widened it with drop-ins
# in ~/sshd_config.d, through an Include at the top, with a start-up preflight that came up
# without them if they did not parse; by then the drop-ins existed for one line in one
# container (or3-dev's forwarding) and for dd-dev's and ds-dev's host-account authorized_keys,
# which the hub replaced. The Include and the preflight are gone; a child that COPYs a drop-in
# in is ignored, so a container's sshd is exactly this file.

Port 2222
ListenAddress 0.0.0.0

# Persisted in the infra-ssh-host volume so a client's known_hosts entry survives a
# rebuild. Regenerating it every build would train you to accept a changed host key,
# which is the one habit that makes the check worthless.
HostKey /home/dev/.ssh-host/ssh_host_ed25519_key
PidFile /home/dev/.ssh-host/sshd.pid

# Key-only, `dev` only. A non-root sshd can only ever serve its own account. The second
# file is the hub's key alone, written by entrypoint.sh, kept apart so that refreshing the
# first (server-add-authorized-keys.yml copies over it) cannot drop the hub.
AuthorizedKeysFile /home/dev/.ssh/authorized_keys /home/dev/.ssh/authorized_keys.hub
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no                 # PAM needs root; a non-root sshd must disable it

# REMOTE forwarding only, for or3-dev: the phone holds `ssh -N -R 2236:10.1.0.236:22` into it,
# and 127.0.0.1:2236 inside is then or3ecr's sshd. `remote` allows -R and nothing else — no
# -L, no stdio forwarding — and GatewayPorts no keeps what -R binds on the container's own
# loopback. The hub's key is `restrict` in every container (authorized_keys.hub), which takes
# forwarding away from it whatever this says, so in practice only or3-dev's phone key can use
# it. No container holds a key to the fleet (the control-node question).
AllowTcpForwarding remote
GatewayPorts no

# Let ssh sessions inherit the env the entrypoint writes to ~/.ssh/environment —
# ANSIBLE_CONFIG among it, which is what makes `ansible fleet -m ping` work from any
# directory in an ssh session rather than only from /workspace/ansible.
PermitUserEnvironment yes

# Compression, stated rather than inherited. `sshd -T` reported `compression yes` on
# OpenSSH 9.2 — the version this was written against, and one the image no longer ships
# since the trixie bump took it to 10.x — so on that version this changed no behaviour
# and was here because the behaviour is worth being able to see. Stating it means the
# line is now doing work if 10.x ever defaults the other way, rather than the setting
# silently following the vendor. It is also only half the switch: compression is negotiated, the ssh
# CLIENT defaults to `no`, and both ends have to offer it. The half that turns it on is
# in ansible/playbooks/client-home-ssh-config.yml, on the aliases the phone uses.
#
# It is worth having on THIS session, which is not true of every sshd. or3's ssh_config
# has the argument: compression belongs on the session whose plaintext it is, because it
# happens before encryption, and ciphertext does not compress. Since 2026-10-26 the phone's
# ssh session terminates on the HUB's sshd (dev/hub/sshd_config, which compresses too), and
# this one is the hub's own hop across the compose network, where compression buys little and
# costs little; kept so a break-glass session straight to a container still has it. or3's own sshd is the other case: it carries an inner session that is
# already ciphertext, and setting it there would buy nothing.
Compression yes

# Drop a wedged session rather than leaving one that accepts input and never answers:
# 3 x 30s of silence and it is gone. The session holder (zmx) is what makes that free — the work is not
# in the ssh session, so losing the session loses nothing.
ClientAliveInterval 30
ClientAliveCountMax 3

# EVERY SESSION GOES THROUGH THE DOOR (2026-10-04, infra#7). The image names the door,
# not each client's ssh config, so a client cannot ask for a program this image lacks,
# and one alias does everything: the door runs a forwarded command (`ssh <c> cmd`, scp,
# Zed, ansible, and the hub's `claude-sessions agent`) as sshd would have — in $HOME — and
# gives anything else a login shell in /workspace. (It gave a terminal the menu until
# 2026-10-26; the menu is the hub's now, dev/hub/.) `ssh -N` opens no session, so a
# forward — or3's phone tunnel — never meets it.
#
# This reverses a rejection in dev/in-workspace's header; the reasons it was rejected,
# and why each no longer holds, are in docs/decisions.md.
ForceCommand /usr/local/bin/dev-door

# A REAL BINARY, NOT internal-sftp, because of the line above. Under ForceCommand sshd
# hands a subsystem request to the forced command with SSH_ORIGINAL_COMMAND set to the
# subsystem's command — and `internal-sftp` is a word no shell can run, so sftp, and
# the sftp-speaking scp that OpenSSH defaults to, would fail. The door runs this path
# like any forwarded command. From openssh-sftp-server, which openssh-server depends on.
Subsystem sftp /usr/lib/openssh/sftp-server
StrictModes yes
