#!/bin/sh
# Run something where this container's work is.
#
#     ssh <c> in-workspace git status        a forwarded command, in the repo
#     ssh -t <c> in-workspace                (no args: a login shell, in the repo)
#
# WHY THIS EXISTS. sshd runs a remote command as `$SHELL -c '…'`, which is NOT a login
# shell — so config.fish's `status is-login` guard is false and its cd to /workspace
# never fires. A plain `ssh` with no command DOES get a login shell and lands correctly,
# which is what makes the symptom baffling: one alias works and the other does not, for
# a reason neither of them mentions. `docker exec` is fine too, because it honours the
# image's WORKDIR. It is only the remote-command path that needs help.
#
# It is not cosmetic: the entrypoint seeds Claude Code's trust dialog for /workspace, so
# a session started in /home/dev asks you to trust a directory that is not the repo.
#
# WHY IT WRAPS ONLY THE DIRECTORY. A first version of this was `dev-claude`, which also
# baked in abduco and the session name. That was one concern too many. WHERE THE WORK IS
# belongs to the container — it is the container's bind mount and nothing outside knows
# the path. WHETHER TO HOLD THE SESSION ACROSS A DROPPED LINK belongs to the client: the
# phone wants abduco because ssh dies at the lock screen, and a laptop running
# `ssh … 'git log'`, a cron, or a one-shot `claude -p` all want no such thing. Wrapping
# both meant a client could not have the second without the first.
#
# ⚠︎ ONCE REJECTED, NOW TAKEN (2026-10-04, infra#7): an sshd ForceCommand. It was turned
# down here as needing sftp and $SSH_ORIGINAL_COMMAND special-cased, as boot-path-ish
# config on the only way in, and for the care CLAUDE.md asks with the thing you are
# connected through. The door already handled the command; sftp became a real binary
# (dev/sshd_config); `docker exec` was always another way in; and
# the care governs the rollout, not the design. The full reckoning is in
# docs/decisions.md. What changed here: the forced command is the DOOR, which cds itself
# for a login, and forwarded commands stay in $HOME — so this is no longer on every
# login's path, only on the ones that ask for the repo.
set -u

if ! cd /workspace 2>/dev/null; then
    # Warn and carry on rather than refuse. If the bind mount is missing you want the
    # command anyway — most likely you are running one to find out why.
    echo "in-workspace: /workspace is not there — the bind mount is missing." >&2
    echo "in-workspace: running in $(pwd) instead. Check INFRA_SRC in dev/.env." >&2
fi

# No arguments is a login shell, so `in-workspace` alone is useful rather than a no-op.
[ "$#" -gt 0 ] || set -- "${SHELL:-/bin/sh}" -l

exec "$@"
