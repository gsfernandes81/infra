# The BAKED half of ~/.ssh/config inside infra-dev. The entrypoint writes the real
# file as:
#
#     /run/infra-secrets/ssh_config.fleet    (zero, one, two — host-specific)
#     this file                              (github.com, then the wildcard)
#
# ORDERING RULE: ssh uses the FIRST value it obtains for each keyword, so specific
# blocks go at the top and the wildcard at the bottom. That is why the fleet blocks
# are prepended and not appended. (The opposite of sshd_config, where Match blocks
# must go last — easy to conflate.)
#
# WHY THE FLEET BLOCKS ARE NOT IN THIS FILE. They carry addresses, and this repo's
# own invariant is that host-specific values live in a gitignored file and never in
# tracked content. They are also a COPY OF SOMETHING ALREADY PROVEN — seed-secrets.sh
# lifts the working blocks out of zero's own ~/.ssh/config rather than composing new
# ones, so the container reaches `one` exactly the way zero does. A block written
# fresh here would be a second description of how to reach a box, free to disagree
# with the one that works, which is the failure this whole repo is about.

# ── GitHub ──────────────────────────────────────────────────────────────────
# A deploy key on gsfernandes81/infra, generated on zero and never transmitted.
# Read-write, so a commit made in here can be pushed. It reaches this one repo and
# nothing else on GitHub — which is the point of it being a deploy key rather than
# an account credential. `gh` is the account credential, and it is a separate,
# optional login kept in a volume; see the README.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_infra_deploy
  IdentitiesOnly yes

# ── defaults — MUST stay last ───────────────────────────────────────────────
# IdentitiesOnly stops ssh offering every key it owns to every server it meets. The
# per-host IdentityFile lines above, and in the fleet blocks prepended before them,
# still win because they are obtained first.
Host *
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
