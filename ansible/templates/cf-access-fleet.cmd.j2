@echo off
rem ProxyCommand for "ssh zero|one|two" on Windows. GENERATED by
rem ansible/playbooks/client-home-ssh-config.yml - edit ansible/templates/cf-access-fleet.cmd.j2,
rem never this file. The Windows twin of fleet-access-ssh.sh.j2: it loads the laptop's fleet
rem Access token into one cloudflared and nothing else, and without a whole token it warns
rem and connects without one. Why: docs/ssh-clients.md
rem
rem CRLF line endings are required (the play writes them) and the text is ASCII only, for
rem the reasons cf-access.cmd.j2 gives.
setlocal
set "TOKENFILE={{ win_fleet_token_file }}"
set "TUNNEL_SERVICE_TOKEN_ID="
set "TUNNEL_SERVICE_TOKEN_SECRET="
if not exist "%TOKENFILE%" goto notoken
rem findstr, not a bare for/f over the file: the token file carries comment lines. The
rem secret travels on findstr's STDOUT, never in its argv.
for /f "usebackq tokens=1,* delims==" %%A in (`findstr /b "TUNNEL_" "%TOKENFILE%"`) do set "%%A=%%B"
if not defined TUNNEL_SERVICE_TOKEN_ID goto notoken
if not defined TUNNEL_SERVICE_TOKEN_SECRET goto notoken
{{ windows_cloudflared }} access ssh --hostname %1
exit /b %errorlevel%
:notoken
set "TUNNEL_SERVICE_TOKEN_ID="
set "TUNNEL_SERVICE_TOKEN_SECRET="
echo fleet: no whole Access token in %TOKENFILE% - run client-home-ssh-config.yml --tags access in WSL; trying without one 1>&2
{{ windows_cloudflared }} access ssh --hostname %1
