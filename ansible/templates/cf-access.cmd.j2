@echo off
rem ProxyCommand for "ssh {{ dev_alias }}" on Windows. GENERATED by
rem ansible/playbooks/configure-client-dev.yml - edit ansible/templates/cf-access.cmd.j2, never
rem this file. Why it exists at all, and why the token is loaded this way rather than
rem put on a command line: docs/ssh-clients.md
rem
rem TWO RULES, BOTH LEARNED THE HARD WAY ON 2026-08-28, AND BOTH INVISIBLE IN A DIFF:
rem
rem 1. CRLF LINE ENDINGS ARE REQUIRED. cmd.exe seeks by byte offset between commands in
rem    a batch file and miscounts on an LF-only one, resuming mid-line and executing
rem    fragments of whatever follows. The symptom is a burst of "'ible' is not
rem    recognized as an internal or external command" - tails of these very comments.
rem    configure-client-dev.yml converts on write; the template itself is LF like every other file
rem    in the repo.
rem
rem 2. ASCII ONLY. This runs under the console codepage, not UTF-8, so an em dash or a
rem    box-drawing character arrives as several bytes of something else. Keep the prose
rem    plain here and put the shape of it in the doc.
setlocal
set "TOKENFILE={{ win_token_file }}"
if not exist "%TOKENFILE%" ( echo cf-access: no token file, run configure-client-dev.yml from WSL 1>&2 & exit /b 1 )
rem findstr, not a bare for/f over the file: the token file carries comment lines that
rem would otherwise be parsed into junk variables. The secret travels on findstr's
rem STDOUT, never in its argv, which is the half a process list shows.
for /f "usebackq tokens=1,* delims==" %%A in (`findstr /b "TUNNEL_" "%TOKENFILE%"`) do set "%%A=%%B"
if not defined TUNNEL_SERVICE_TOKEN_ID ( echo cf-access: no TUNNEL_SERVICE_TOKEN_ID in token file 1>&2 & exit /b 1 )
if not defined TUNNEL_SERVICE_TOKEN_SECRET ( echo cf-access: no TUNNEL_SERVICE_TOKEN_SECRET in token file 1>&2 & exit /b 1 )
rem setlocal above scopes those two to this script; the child below inherits them and
rem nothing else does. The argument passed through below is ssh's hostname token.
{{ windows_cloudflared }} access ssh --hostname %1
