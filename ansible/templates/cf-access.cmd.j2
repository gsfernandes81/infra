@echo off
rem  ProxyCommand for `ssh {{ dev_alias }}` on WINDOWS. Generated by
rem  ansible/playbooks/dev-client.yml from WSL — edit the template, never this file.
rem
rem  WHY IT EXISTS. Every POSIX client does this job inline, in one ssh_config line:
rem
rem      ProxyCommand sh -c '. ~/.config/{{ dev_alias }}/token; exec cloudflared access ssh --hostname %h'
rem
rem  Win32-OpenSSH has no `sh`, and the secret must not move to the command line to
rem  compensate: an argument is visible in the process list and lands in shell history.
rem  That rule is in the repo root's CLAUDE.md and it does not stop applying on the
rem  client side. So the load-then-exec moves in here, and the guarantee is unchanged —
rem  the token reaches the environment of one short-lived cloudflared and nothing else.
rem  `setlocal` is the half that makes that true: the variables die with this script
rem  rather than joining the environment of whatever started ssh.
rem
rem  LF line endings are fine here and are what ansible writes. cmd.exe's line-ending
rem  troubles are with labels, `goto`, and multi-line parenthesised blocks; there are
rem  none below, and every `if` is a single line for exactly that reason.

setlocal

set "TOKENFILE={{ win_token_file }}"
if not exist "%TOKENFILE%" ( echo cf-access: no token at %TOKENFILE% - run ansible/playbooks/dev-client.yml from WSL 1>&2 & exit /b 1 )

rem  findstr, not a bare `for /f` over the file. The token file also carries comment
rem  lines, and a `for /f ... delims==` over those would `set` junk variables named after
rem  the prose. /b anchors the match to the start of the line, so only the TUNNEL_ lines
rem  survive. The secret travels on findstr's STDOUT — not in its argv, which is the half
rem  a process list shows.
for /f "usebackq tokens=1,* delims==" %%A in (`findstr /b "TUNNEL_" "%TOKENFILE%"`) do set "%%A=%%B"

rem  Fail here rather than letting cloudflared fail. An empty token gives an Access
rem  rejection that reads like the tunnel being down, and that misdirection is the exact
rem  failure this play spends its assertions avoiding on the other clients.
if not defined TUNNEL_SERVICE_TOKEN_ID ( echo cf-access: %TOKENFILE% has no TUNNEL_SERVICE_TOKEN_ID 1>&2 & exit /b 1 )
if not defined TUNNEL_SERVICE_TOKEN_SECRET ( echo cf-access: %TOKENFILE% has no TUNNEL_SERVICE_TOKEN_SECRET 1>&2 & exit /b 1 )

rem  %1 is ssh's %h — the hostname from the Host block, passed in rather than baked in,
rem  so the -sh alias shares this one wrapper.
rem
rem  Batch has no `exec`, so cloudflared runs as a CHILD of this cmd.exe rather than
rem  replacing it. Two processes per session instead of one, and a hard kill of the
rem  ProxyCommand can leave the child behind for a moment. Accepted: the alternative is a
rem  compiled shim, and this is a client convenience on a laptop, not something on a
rem  boot path. If stray cloudflared processes ever accumulate, this line is why.
{{ windows_cloudflared }} access ssh --hostname %1
