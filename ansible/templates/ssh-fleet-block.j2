# The fleet. GENERATED: edit ansible/templates/ssh-fleet-block.j2 and re-run
# playbooks/configure-client.yml, not this. Reasoning: docs/ssh-clients.md
#
#   <host>                    via that box's own cloudflared tunnel
#   <host>-local              direct on the LAN
#   <host>-zero|-one|-two     through another box, over the LAN
{% if adb_jump %}
#   <host>-s24                through the phone, over USB — for when only it has a network
{% endif %}
#
# Every box is reachable through both of the others. That mesh exists because on
# 2026-08-23 `two`'s tunnel was stopped while it was the only configured route to it.
#
# ORDERING: ssh takes the FIRST value it obtains for each keyword, so this block sits
# ABOVE `Host *`. The playbook inserts it there rather than appending.

# ── LAN ───────────────────────────────────────────────────────────────────────
Host zero-local
  HostName {{ ip_zero }}

Host one-local
  HostName {{ ip_one }}

Host two-local
  HostName {{ ip_two }}

# ── through another box, over the LAN ─────────────────────────────────────────
# HostName is resolved ON the jump host, so these are LAN addresses as it sees them.
Host zero-one zero-two
  HostName {{ ip_zero }}

Host one-zero one-two
  HostName {{ ip_one }}

Host two-zero two-one
  HostName {{ ip_two }}

# ── the jump rules ────────────────────────────────────────────────────────────
# THESE DEPEND ON hosts/*/system/sshd-infra.conf, which sets AllowTcpForwarding yes with
# PermitOpen scoped to these three addresses on port 22. If it is ever removed, ProxyJump
# fails with "administratively prohibited" — revert to the form these had until
# 2026-08-23, which needs no server-side change at all:
#
#     ProxyCommand ssh <host> nc %h %p
#
# `*-zero` matches an alias ENDING in `-zero`, so no dev-container alias is caught here.
Host *-zero
  ProxyJump zero

Host *-one
  ProxyJump one

Host *-two
  ProxyJump two

# ── through each box's own cloudflared tunnel ─────────────────────────────────
Host zero
  HostName ssh-zero.gsrpi.uk

Host one
  HostName ssh-one.gsrpi.uk

Host two
  HostName ssh-two.gsrpi.uk

# Listed explicitly, not `zero*`: that would also catch zero-local and zero-two, which
# must NOT go through the edge. No token is sourced here — the boxes' tunnels admit you
# on your certificate, while every dev container's own hostname sits behind an Access
# service token and gets the `sh -c` form from configure-client-dev.yml instead.
Host zero one two
  ProxyCommand {{ cloudflared }} access ssh --hostname %h

# NO DEV CONTAINER IS IN THIS BLOCK, and the reason is what they are rather than where
# they are. `zero-dev-dd`, `zero-dev-ds` and `zero-dev-or3` were aliases for the
# `ssh-zero-dev-*` rules on ZERO'S host tunnel — a door zero opens on a container's
# behalf. Every dev container now comes up with its own connector, its own hostname and
# its own Access token, and configure-client-dev.yml writes three aliases for each. dd-dev and
# ds-dev are not running at all until they are deployed that way, so an alias for either
# would name a hostname with nothing behind it, which fails exactly like a container being
# down. or3's rule is already gone (7bb2075).
#
# The rules themselves are still in hosts/zero/system/cloudflared-config.yml. Removing
# them is an edit to a boot-path file plus a connector cycle on zero, which is the owner's
# to run — phase 2i in docs/management-plane.md, and not something dropping an alias does.
{% if adb_jump %}

# ── the phone as a jump host — WINDOWS ONLY ───────────────────────────────────
# Every byte of egress happens ON THE PHONE, so the targets are tunnel hostnames and the
# phone runs cloudflared. Not ProxyJump: an ssh:// ingress is not raw TCP at the edge.
#
# `adb forward` runs as a SIDE EFFECT of the Match below — ssh evaluates `Match exec`
# while parsing, so the forward exists before s24 is dialled. No phone attached means adb
# exits non-zero, the block does not apply, and you get a plain connection refused.
#
# Not rendered for WSL or the phone, and that is not an oversight — docs/ssh-clients.md.
Match host s24 exec "adb forward tcp:8022 tcp:8022"
  ConnectTimeout 10

Host zero-s24
  HostName ssh-zero.gsrpi.uk

Host one-s24
  HostName ssh-one.gsrpi.uk

Host two-s24
  HostName ssh-two.gsrpi.uk

Host *-s24
  ProxyCommand ssh s24 {{ phone_cloudflared }} access ssh --hostname %h

Host s24
  # 127.0.0.1, NOT localhost: ssh tries ::1 first and adb forward binds IPv4 only, so the
  # name fails with kex_exchange_identification while the forward is plainly up.
  HostName 127.0.0.1
  Port 8022
  # Android's uid for Termux. It CHANGES if the app is reinstalled — check this first if
  # `ssh s24` starts refusing.
  User {{ s24_user }}
{% endif %}

# ── one host key per BOX, not per path ────────────────────────────────────────
# Else a rarely-used route has no stored key and prompts you to accept whatever it is
# handed, mid-rescue. To clear one: ssh-keygen -R zero
Host zero zero-local zero-one zero-two zero-s24
  HostKeyAlias zero

Host one one-local one-zero one-two one-s24
  HostKeyAlias one

# ChaCha20 first: `two` is an ARM1176 with no AES acceleration, where software AES is both
# slower AND exposed to cache-timing side channels. Ordered, not pinned, so this rescue
# path cannot fail closed.
Host two two-local two-zero two-one two-s24
  HostKeyAlias two
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com

# ── shared: the account, and multiplexing ─────────────────────────────────────
Host zero* one* two*
  User gavin
{% if multiplex %}
  # Keyed by ALIAS (%n): %C and %r@%h:%p hash the RESOLVED address, so zero-one and
  # zero-local would share one socket — and a rescue path that silently reuses a working
  # direct connection is not a test of anything. Omitted on Windows, which cannot do it.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%n-%r
  ControlPersist 10m
{% endif %}
