# {{ dev_alias }} — two routes to one container. GENERATED: edit
# ansible/templates/ssh-dev-block.j2 and re-run playbooks/configure-client.yml, not this.
# Why any of it is shaped this way: docs/ssh-clients.md
#
#   {{ dev_alias }} — the claude-sessions menu: every session in the container, Enter to
#     attach or resume, n for a new one, q to leave. It carries a RemoteCommand, so
#     `ssh {{ dev_alias }} <cmd>` is an ERROR and scp/sftp to it will not work. A container
#     whose base predates the door (BASE_TAG < 2026.10.02.1) answers "in-workspace: 42:
#     exec: claude-sessions-door: not found" — bump that repo's BASE_TAG; {{ dev_alias }}-sh
#     still gets in.
#   {{ dev_alias }}-sh — a shell instead, same route. Use it for either of those.
#
# NO TOKEN, NO CONNECTION, AND IT SAYS SO. The block is written whether or not this client
# holds {{ dev_alias }}'s Access token; without one the ProxyCommand stops before cloudflared
# starts, naming the run that fixes it — and so does a file that is there but empty or
# half-written, which would otherwise reach cloudflared with no token and land on its
# browser login. Never that: these apps admit service tokens only, and that flow is no use
# from Termux.
#
# THERE IS NO `-lan` ALIAS, and the way in it named is still open. Break glass by hand:
# `ssh <host>`, then `ssh -p <port> dev@127.0.0.1` on that box. The ports are in
# ansible/playbooks/configure-client.yml. An alias for that hop had to hard-code which
# host the container sits on, which is the one fact a movable container does not have.
Host {{ dev_alias }}
  HostName {{ dev_hostname }}
  User dev
  RequestTTY yes
  RemoteCommand in-workspace claude-sessions-door
{% if windows %}
  ProxyCommand {{ win_wrapper }} %h
{% else %}
  ProxyCommand sh -c 'f="{{ token_file }}"; if [ -r "$f" ]; then . "$f"; if [ -n "${TUNNEL_SERVICE_TOKEN_ID:-}" ] && [ -n "${TUNNEL_SERVICE_TOKEN_SECRET:-}" ]; then exec "{{ cloudflared }}" access ssh --hostname %h; fi; echo "{{ dev_alias }}: $f is there but does not hold both halves of a token - run configure-client-dev.yml -e alias={{ dev_alias }} --tags access -e replace_token=true" >&2; exit 1; fi; echo "{{ dev_alias }}: no Access token at $f - run configure-client-dev.yml -e alias={{ dev_alias }} --tags access" >&2; exit 1'
{% endif %}

Host {{ dev_alias }}-sh
  HostName {{ dev_hostname }}
  User dev
{% if windows %}
  ProxyCommand {{ win_wrapper }} %h
{% else %}
  ProxyCommand sh -c 'f="{{ token_file }}"; if [ -r "$f" ]; then . "$f"; if [ -n "${TUNNEL_SERVICE_TOKEN_ID:-}" ] && [ -n "${TUNNEL_SERVICE_TOKEN_SECRET:-}" ]; then exec "{{ cloudflared }}" access ssh --hostname %h; fi; echo "{{ dev_alias }}: $f is there but does not hold both halves of a token - run configure-client-dev.yml -e alias={{ dev_alias }} --tags access -e replace_token=true" >&2; exit 1; fi; echo "{{ dev_alias }}: no Access token at $f - run configure-client-dev.yml -e alias={{ dev_alias }} --tags access" >&2; exit 1'
{% endif %}

# One host key for the container, not one per route, so the entry is stored under a name
# that does not move if the route does. To clear it: ssh-keygen -R {{ dev_alias }}
Host {{ dev_alias }} {{ dev_alias }}-sh
  HostKeyAlias {{ dev_alias }}
{% if identity_named | bool %}
  # IdentitiesOnly stops ssh walking every key an agent holds and hitting MaxAuthTries
  # before it reaches the right one. It also means an AGENT key is only offered when its
  # public half matches the file named here — so both lines are omitted on a client that
  # has neither ~/.ssh/id_ed25519 nor its .pub, where they would produce
  # "Permission denied (publickey)" with nothing to offer.
  IdentityFile {{ identity_path }}
  IdentitiesOnly yes
{% else %}
  # No IdentityFile or IdentitiesOnly: this client has no {{ ssh_key | default('key file', true) }}
  # to name, so its keys come from an agent and ssh's own discovery. Naming a file that is
  # not there, with IdentitiesOnly, leaves ssh nothing to offer at all.
{% endif %}
  ServerAliveInterval 30
  ServerAliveCountMax 3
  Compression yes
