# {{ dev_alias }} — three routes to one container. GENERATED: edit
# ansible/templates/ssh-dev-block.j2 and re-run playbooks/this-client.yml, not this.
# Why any of it is shaped this way: docs/ssh-clients.md
#
#   {{ dev_alias }} — the claude session itself, reattached. It carries a RemoteCommand, so
#     `ssh {{ dev_alias }} <cmd>` is an ERROR and scp/sftp to it will not work.
#   {{ dev_alias }}-sh — a shell instead, same route. Use it for either of those.
#   {{ dev_alias }}-lan — break-glass through zero's sshd. Independent of THIS container's
#     tunnel, Access app and token; NOT of Cloudflare, since `Host zero` is zero's own
#     tunnel. From the LAN, one override gets past that too:
#       ssh -o ProxyCommand='ssh zero-local nc %h %p' {{ dev_alias }}-lan
Host {{ dev_alias }}
  HostName {{ dev_hostname }}
  User dev
  RequestTTY yes
  RemoteCommand in-workspace abduco -A claude claude
{% if windows %}
  ProxyCommand {{ win_wrapper }} %h
{% else %}
  ProxyCommand sh -c '. {{ token_file }}; exec {{ cloudflared }} access ssh --hostname %h'
{% endif %}

Host {{ dev_alias }}-sh
  HostName {{ dev_hostname }}
  User dev
{% if windows %}
  ProxyCommand {{ win_wrapper }} %h
{% else %}
  ProxyCommand sh -c '. {{ token_file }}; exec {{ cloudflared }} access ssh --hostname %h'
{% endif %}

# nc, not ProxyJump: zero's PermitOpen does not include 127.0.0.1:{{ dev_lan_port }}, so a jump
# is refused. Needs `Host zero` from the infra-fleet block — that block is a prerequisite.
Host {{ dev_alias }}-lan
  HostName 127.0.0.1
  Port {{ dev_lan_port }}
  User dev
  ProxyCommand ssh zero nc %h %p

# One host key for the container, not one per route — else the rarely-used path has no
# stored entry and prompts you to accept whatever it is handed, mid-rescue.
# To clear it: ssh-keygen -R {{ dev_alias }}
Host {{ dev_alias }} {{ dev_alias }}-sh {{ dev_alias }}-lan
  HostKeyAlias {{ dev_alias }}
  IdentityFile {{ ssh_key }}
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  Compression yes
