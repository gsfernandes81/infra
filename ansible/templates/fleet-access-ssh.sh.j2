#!/bin/sh
{# ASCII ONLY, like every template that reaches a client. A Jinja comment, so it renders to nothing. #}
# ProxyCommand for the fleet's tunnel aliases (zero, one, two) on this client. GENERATED by
# ansible/playbooks/client-home-ssh-config.yml from ansible/templates/fleet-access-ssh.sh.j2;
# edit that, not this. Why it is shaped this way: docs/ssh-clients.md.
#
# It loads this client's Access service token for the fleet into the environment of the
# one cloudflared it runs, and nowhere else: not a shell profile, not the ssh config, not
# a command line. Without a whole token it says so and connects without one. Before a
# host's gate exists that still works; after, Cloudflare refuses, and the message above
# the refusal names the run that fixes it.
#
# POSIX sh, because ssh runs a ProxyCommand under /bin/sh whatever the login shell is. The
# phone's copy is also what the laptop's `<host>-s24` aliases run, over ssh.
f="{{ fleet_token_file }}"
unset TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET
if [ -r "$f" ]; then . "$f"; fi
if [ -z "${TUNNEL_SERVICE_TOKEN_ID:-}" ] || [ -z "${TUNNEL_SERVICE_TOKEN_SECRET:-}" ]; then
	unset TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET
	echo "fleet: no whole Access token in $f - run client-home-ssh-config.yml --tags access; trying without one" >&2
fi
exec "{{ cloudflared }}" access ssh --hostname "$1"
