#!/bin/bash
# combustion: network
#
# First-boot script for the docker-store simulation VM only (sim/microos/README.md); not a
# host's. Runs once inside a transactional-update shell, from the config drive's
# "combustion" directory.
set -euxo pipefail

# Leap's first-boot wizard waits at the console for answers and powers the box off if it
# fails. Its unit is recorded before it is masked, so the probe can say whether Combustion
# alone would have kept it from running.
systemctl cat jeos-firstboot.service > /root/jeos-firstboot.unit 2>&1 || true
systemctl is-enabled jeos-firstboot.service >> /root/jeos-firstboot.unit 2>&1 || true
systemctl mask jeos-firstboot.service || true

install -d -m 700 /root/.ssh
install -m 600 authorized_keys /root/.ssh/authorized_keys
systemctl enable sshd

zypper --non-interactive install docker docker-compose btrfsprogs
systemctl enable docker

mkdir -p /etc/rebootmgr
printf '[rebootmgr]\nstrategy=off\n' > /etc/rebootmgr/rebootmgr.conf
printf 'REBOOT_METHOD=none\n' > /etc/transactional-update.conf

echo "combustion-docker-store: done" > /dev/console
