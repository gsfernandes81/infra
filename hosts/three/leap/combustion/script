#!/bin/bash
#
# three's first-boot script for Leap 16.1 Immutable, run once by Combustion from the stick
# `leap/make-stick --new three` builds (leap/README.md). Reviewed like any boot-path file;
# it carries no secret, and reads the carry-over from the stick. The steps it shares with
# every Leap host are in leap/firstboot.sh; what follows is three's own: the off-site
# backup in the Argon EON (plans/three.md).
#
# three is a NEW host, so unlike one it starts with no tunnel (its unit waits for a config,
# made after this boot), no deployment .env and no volumes. Its backup array is not
# touched here: the drive is formatted at the visit by hosts/three/leap/make-backup, and
# unlocked by hand after every boot (hosts/three/leap/README.md).
#
# No `# combustion:` line on purpose: Combustion brings up no network, so everything here
# is offline work, and the rest is the play's (plans/pi-setup.md). The wired port is on
# DHCP until the play installs three's UK profile.
set -euo pipefail

host=three
# gavin's uid and gid, the fleet's usual, which Syncthing's PUID and PGID name.
gavin_uid=1000
gavin_gid=1000

# shellcheck source=leap/firstboot.sh
. ./leap/firstboot.sh

say "starting $host"
record_baseline
check_carry "$host"
mount_subvolumes
grow_root

echo "$host" > /etc/hostname
set_root_password
make_gavin "$gavin_uid" "$gavin_gid"
install_host_keys
install_login
# The tunnel's credentials, once three has a tunnel: a rebuild carries them, check_carry
# requires them whenever the config is there, and cloudflared reads nothing else.
if [ -e "$stick/host/system/cloudflared-config.yml" ]; then
	install -D -m 600 "$stick/carry/cloudflared/$host.json" "/etc/cloudflared/$host.json"
fi
stage_carry
keep_volume_tars
label_subvolumes

say "done; $host boots into its configured snapshot next"

# What the play does, that this script used to (notes for its author; nothing here runs):
# - Packages beyond the common list: cryptsetup for make-backup (the unlock itself is
#   systemd's, in the udev package every image has); Wi-Fi in case Singapore has no Ethernet
#   for it: wpa_supplicant, which NetworkManager drives, and the Pi radio's own files
#   (bcm43xx-firmware, noarch). The radio's driver firmware, kernel-firmware-brcm, is left
#   to the Pi image and is a bench check (`rpm -q kernel-firmware-brcm`): installing it
#   could clash with an image that carries all firmware in one package. No Wi-Fi profile:
#   its password is added on the box before shipping (hosts/three/leap/README.md). snapper
#   for the backup's snapshots, named although an Immutable image carries it for its own root.
# - Two users for zero's backup (plans/three-backup-pull.md). `backup` pulls it: systemd
#   runs backup-pull as this user, which owns the copy in /media/backup/immich/current and
#   nothing else, so whatever zero sends is parsed without privilege. It never logs in, so
#   it has no shell (/usr/sbin/nologin) and no authorized_keys; its key to zero is made on
#   the box by the owner, not carried. `restore` lets zero read its own backups back, by
#   one authorized_keys line whose forced command starts a read-only rsync daemon. A real
#   shell (/bin/bash), because sshd runs a key's forced command through the user's shell,
#   so nologin would refuse that too; the key's restrictions keep it from being used as one.
#   Neither has a password. Both are system users with their own group, homes /home/backup
#   and /home/restore (0755, with a .ssh each, 0755) owned by root, so neither user can
#   change its keys, its ssh config or the host key it trusts. A user of either name that
#   the play did not make stops it; one it made, on an earlier run, is kept.
# - Every tracked file for this host, each at the path its header names; notes (*.md,
#   *.toml) are skipped, a sudoers file is checked with visudo -cf.
# - The array's mountpoint /media/backup exists only if a snapshot makes it, and while the
#   array is locked the read-only root refuses every write to it. Then its fstab entry,
#   noauto, appended only if that exact line is missing.
# - systemctl enable argon-fan.service: the Argon EON's fan, from the CPU's temperature.
#   Without the bus extraconfig.txt turns on at the next power-on, it waits and retries,
#   running rather than failed.
# - Syncthing's sync and discovery ports in firewalld, for devices on the same network as
#   three; its GUI stays on 127.0.0.1. firewalld is on in Leap and allows only ssh and
#   DHCPv6 otherwise.
