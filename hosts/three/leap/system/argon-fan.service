# infra-os:   leap
# infra-init: systemd
# infra-path: /etc/systemd/system
# infra-name: argon-fan.service
# infra-mode: 0644
#
# The Argon EON's fan, on or off from the CPU's and the backup drive's temperatures
# (/usr/local/sbin/argon-fan). With no bus yet it logs and retries every 30 s, running
# rather than failed, so a box without one (the simulation's VM) boots clean. Its stop
# turns the fan on.
[Unit]
Description=Turn the Argon EON's fan on or off by the CPU's and drive's temperatures
After=systemd-modules-load.service

[Service]
ExecStart=/usr/local/sbin/argon-fan
Restart=on-failure
RestartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
