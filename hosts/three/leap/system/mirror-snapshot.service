# infra-os:   leap
# infra-init: systemd
# infra-path: /etc/systemd/system
# infra-name: mirror-snapshot.service
# infra-mode: 0644
#
# Snapshots /media/mirror/received-backups/immich/current once a pull has succeeded, then
# prunes to the limits in /etc/snapper/configs/received-immich, then records what was
# pulled in last-pulled (plans/three-backup-pull.md). Started only by mirror-pull.service's
# OnSuccess=, as root: the snapshots are root's and read-only, out of the backup user's
# reach, so only three ever makes or deletes its history.
#
# state/pulled is the backup user's, written only by a pull that succeeded and removed at
# the start of the next, so its condition skips this unit after a pull that found nothing
# new. Being the backup user's, it is read and never trusted: the number must be digits and
# the time rsync's, or nothing is taken, and only those values reach snapper and last-pulled,
# which is root's, in root's directory. last-pulled is written last, so a snapshot that fails
# leaves the next pull to copy nothing new and snapshot again.
#
# snapper runs with --no-dbus: the config is in no SNAPPER_CONFIGS list, so neither
# snapperd nor Leap's own snapper timers know it. A condition, never RequiresMountsFor=
# (docker-mirror.conf says why); PartOf= the mount, so a lock stops it first.
[Unit]
Description=Snapshot the pull of zero's backup that just finished
After=media-mirror.mount
PartOf=media-mirror.mount
ConditionPathIsMountPoint=/media/mirror
ConditionPathExists=/media/mirror/received-backups/immich/state/pulled

[Service]
Type=oneshot
TimeoutStartSec=30min
Environment=D=/media/mirror/received-backups/immich
ExecStart=/bin/sh -euc '\
	read -r n t < "$$D/state/pulled"; \
	case "$$n" in "" | *[!0-9]*) echo "mirror-snapshot: state/pulled holds no snapshot number" >&2; exit 1 ;; esac; \
	case "$$t" in "" | *[!0-9/:T]*) echo "mirror-snapshot: state/pulled holds no time" >&2; exit 1 ;; esac; \
	/usr/bin/snapper --no-dbus -c received-immich create --cleanup-algorithm timeline --description "pulled $$n"; \
	/usr/bin/snapper --no-dbus -c received-immich cleanup timeline; \
	echo "$$n $$t" > "$$D/last-pulled.new"; \
	mv "$$D/last-pulled.new" "$$D/last-pulled"; \
	echo "mirror-snapshot: snapshot taken of the pull of zero snapshot $$n"'
