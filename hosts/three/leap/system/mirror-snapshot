#!/bin/sh
# infra-os:   leap
# infra-init: systemd
# infra-path: /usr/local/sbin
# infra-name: mirror-snapshot
# infra-mode: 0755
#
# Takes today's read-only snapshot of the backup zero pushes into /media/mirror/incoming,
# and keeps the newest 90 (plans/three.md § Backups). Run as root by mirror-snapshot.timer,
# twice a day; it makes at most one a day, so a turn it skips is taken twelve hours later.
#
# It skips its turn while the backup user has any process, which is zero's rsync: a
# snapshot mid-run would keep half a run. The backup user cannot reach the snapshots, so a
# compromised zero can at worst overwrite the current copy.
set -eu

src=/media/mirror/incoming
dst=/media/mirror/snapshots
keep=90

if pgrep -u backup >/dev/null; then
	echo "mirror-snapshot: the backup user's rsync is running; skipping this turn"
	exit 0
fi
today=$(date -u +%F)
if [ -e "$dst/$today" ]; then
	echo "mirror-snapshot: $today exists"
else
	btrfs subvolume snapshot -r "$src" "$dst/$today"
fi
# Names are dates, so their order is their age.
ls -1 "$dst" | sort | head -n "-$keep" | while read -r old; do
	btrfs subvolume delete "$dst/$old"
done
