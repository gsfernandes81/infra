#!/sbin/openrc-run
# infra-os:   alpine
# infra-init: openrc
# infra-path: /etc/init.d
# infra-name: zram-swap
# infra-mode: 0755
# Compressed swap in RAM, used before the SSD swap partition (/dev/sda3, priority -2).
#
# zero swapped only to the SSD before this, beside Immich, Postgres and the dev containers in
# 3.9 GB. A page compressed into RAM comes back faster than one read from the SSD, and costs
# the SSD no writes. sda3 stays behind it as the overflow, so nothing is lost if this is off.
#
# ZRAM_SIZE is the UNCOMPRESSED capacity, not the RAM it takes, and RAM is taken only as pages
# arrive. zstd packed `one`'s swapped pages about 3.4:1, so 2G full typically holds about
# 600 MB; a page that does not compress is stored as it is, so the bound is 2G. Half of RAM,
# the default of Fedora and systemd's zram-generator. `zramctl` or
# /sys/block/zram0/mm_stat shows the real figure.
#
# Not boot-critical: nothing depends on it, and a failed start leaves the SSD swap as it was.
# It is a service rather than an /etc/local.d script so that rc-status shows it and
# `rc-service zram-swap stop` takes it away. Stopping is a swapoff: every page comes back
# into RAM, or out to sda3 if RAM is short, so a stop under pressure is slow. At shutdown or
# reboot it skips the swapoff, which would be wasted work there. `before docker` orders it to
# start before the containers and stop after them.

name="zram swap"
description="Compressed swap in RAM, ahead of the SSD swap partition"

ZRAM_SIZE=2G
ZRAM_ALGO=zstd
ZRAM_PRIO=100

depend() {
	need sysfs dev
	after modules localmount
	before docker
}

zram_on() {
	grep -q '^/dev/zram0 ' /proc/swaps
}

start() {
	ebegin "Starting zram swap (${ZRAM_SIZE}, ${ZRAM_ALGO})"
	if zram_on; then
		eend 0
		return 0
	fi
	# Not fatal on its own: a zram built into the kernel has no module to load. The device
	# check below is the real test.
	modprobe -q zram 2>/dev/null || true
	# The node normally exists once the module is in; wait for it, bounded, all the same.
	i=0
	while [ ! -b /dev/zram0 ] && [ "$i" -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ ! -b /dev/zram0 ]; then
		eend 1 "/dev/zram0 did not appear: no zram in this kernel?"
		return 1
	fi
	# A device sized by an earlier, failed start cannot be sized again until it is reset.
	if ! echo 1 > /sys/block/zram0/reset 2>/dev/null; then
		eend 1 "could not reset /dev/zram0: something holds it open"
		return 1
	fi
	if ! echo "$ZRAM_ALGO" > /sys/block/zram0/comp_algorithm 2>/dev/null; then
		eend 1 "could not set $ZRAM_ALGO; the kernel offers: $(cat /sys/block/zram0/comp_algorithm)"
		return 1
	fi
	echo "$ZRAM_SIZE" > /sys/block/zram0/disksize &&
		mkswap /dev/zram0 >/dev/null &&
		swapon -p "$ZRAM_PRIO" /dev/zram0
	eend $?
}

stop() {
	ebegin "Stopping zram swap"
	case "$RC_RUNLEVEL" in
	shutdown|reboot)
		eend 0
		return 0
		;;
	esac
	if zram_on && ! swapoff /dev/zram0; then
		eend 1 "swapoff failed, so zram swap is left on"
		return 1
	fi
	echo 1 > /sys/block/zram0/reset 2>/dev/null
	eend 0
}
