# infra-os:   alpine
# infra-init: openrc
# infra-path: /etc/sudoers.d
# infra-name: backup
# infra-mode: 0440
#
# The one command zero's backup user may run as root, with no password: the forced command in
# backup-authorized-keys, word for word (plans/three-backup-pull.md). setpriv, util-linux's
# from Alpine's `setpriv` package, which installs /bin/setpriv over BusyBox's applet of the
# same name (BusyBox's has no --reuid), drops back to zero's backup user, keeps
# CAP_DAC_READ_SEARCH alone in the inheritable and ambient sets, and runs rsync's daemon,
# which so reads any file and can change none. Root lasts only as long as setpriv takes,
# and the rsync is the system's own, so an Alpine update to rsync applies at once.
#
# sudo matches the arguments exactly, so the forced command and this line change together.
# In sudoers a = inside an argument is written \=.
backup ALL=(root) NOPASSWD: /bin/setpriv --reuid\=backup --regid\=backup --init-groups --inh-caps\=+dac_read_search --ambient-caps\=+dac_read_search /usr/bin/rsync --server --daemon --config\=/etc/rsyncd-backup.conf .
