# deployments/destiny-director/.env.example — committed. Copy to .env and fill in.
# .env is gitignored and holds the live Discord bot token and the Postgres password.
#
#   cp .env.example .env && chmod 600 .env
#
# Read by BOTH compose services via `env_file:`, so it carries the Postgres password
# and the bot's own configuration in one file.
#
# HOW THE APP FAILS WHEN THIS IS WRONG: dd/common/cfg.py is imported before anything
# else and validates as it goes, so a missing required variable is a `ValueError:
# Environment variable 'X' not found.` at import — instantly, naming the first one it
# hit, before the bot touches Discord or the database. Fix, redeploy, repeat. Only
# three variables are genuinely required (marked REQUIRED below); the rest have
# defaults, but several of those defaults (a channel id of 0, an empty FOLLOWABLES)
# mean "this feature is dormant", which looks like a broken bot rather than a missing
# variable. Set them.
#
# Verified against dd/common/cfg.py, the app repo's .env-example, supervisord.conf and
# the Dockerfile as of Aug 2026.


# =================================================================================
# 1. DO NOT SET THESE HERE — dd-ctl supplies them per deploy
# =================================================================================
# podman-compose has FLIPPED the precedence between this file and the process
# environment across releases — 1.0.6 let this file win, 1.6.0 (what Alpine 3.24 ships)
# lets the process environment win. Rather than depend on which version is installed,
# these five simply do not belong in this file: dd-ctl passes them per deploy, and it
# refuses to deploy if it finds any of them set here.
#
# Leave all five commented. They are listed so their absence is a decision, not a gap.
#
# DD_BOT=beacon
#     Which bot to run. dd-ctl sets it from `deploy <beacon|anchor>`; compose maps it
#     onto RAILWAY_SERVICE_NAME in the container.
# DD_IMAGE_REF=:slim-stack
#     The part of the image reference after ghcr.io/gsfernandes81/destiny-director —
#     `:<tag>` or `@sha256:<64 hex>`. dd-ctl validates the caller's half and adds the
#     separator. Branch tags move; pin a digest for anything you
#     want to reproduce later. The workflow's job summary prints the digest it pushed.
# DD_MALLOC_CONF=...
#     Set by dd-ctl to the per-bot jemalloc string (see MALLOC_CONF below).
#
# RAILWAY_SERVICE_NAME=beacon
#     Read by the IMAGE, not by cfg.py: supervisord's only program is
#     `python -OO -m dd.$RAILWAY_SERVICE_NAME`, and supervisord refuses to start at all
#     if it is unset rather than guessing. Railway injects it from the service name; on
#     this box compose sets it from DD_BOT. Setting it here as well does nothing useful
#     (compose's `-e` wins over `--env-file`) and makes the file lie about which bot is
#     deployed.
# MALLOC_CONF=narenas:2,background_thread:true,dirty_decay_ms:10000,muzzy_decay_ms:10000
#     jemalloc tuning, read by the loader via LD_PRELOAD, not by cfg.py. The image bakes
#     the beacon-correct value (the same string without `narenas:2`); ANCHOR wants
#     narenas:2 because jemalloc's default of 4*ncpu reserves per-arena metadata that
#     bloats anchor's small single-event-loop process for no concurrency benefit, while
#     beacon — the large, hot consumer arena parallelism actually helps — wants the
#     default. It cannot be baked per-bot: one image, one supervisord program, and
#     supervisord has no conditionals. dd-ctl is where that is fixed. Forgetting it
#     costs anchor a little RAM; nothing breaks.


# =================================================================================
# 2. Postgres (the compose stack's own database)
# =================================================================================
# Consumed by the postgres container. POSTGRES_USER=dd and POSTGRES_DB=kyber are set in
# compose.yaml (not secret); only the password lives here.
#
# THIS MUST MATCH the password embedded in DATABASE_URL below. They are two independent
# strings that have to agree, and a mismatch shows up as an authentication failure from
# the bot several minutes into a slow cold start.
POSTGRES_PASSWORD=change_me_before_first_boot


# =================================================================================
# 3. Database — REQUIRED (one of the two URLs)
# =================================================================================
# cfg.py prefers DATABASE_PRIVATE_URL and falls back to DATABASE_URL; at least one must
# be set or import fails. Railway injects both; here, set only DATABASE_URL.
#
# `postgres` is the compose service name, resolved by aardvark-dns on the stack's
# network — which is why root-setup.sh treats aardvark-dns as non-optional. The
# user/password/database must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
DATABASE_URL=postgresql://dd:change_me_before_first_boot@postgres:5432/kyber

# DATABASE_PRIVATE_URL is Railway's internal-network URL and wins over DATABASE_URL when
# both are set. Leave it unset here — setting it would shadow the URL above.
# DATABASE_PRIVATE_URL=

# Defaults to true, which appends sslmode=require. Both containers are on one host's
# private compose network; there is no TLS to negotiate and postgres:17-alpine is not
# configured to offer any, so leaving this unset makes every connection fail.
DATABASE_SSL=false


# =================================================================================
# 4. The other two REQUIRED variables
# =================================================================================
# No defaults in cfg.py — import raises without them, even though a test bot may never
# render either image.
LOST_SECTOR_GIF_URL="https://www.example.com/lost-sector.gif"
XUR_IMAGE_URL="https://www.example.com/xur.png"


# =================================================================================
# 5. Discord — tokens and environment
# =================================================================================
# The TEST bot's token, not production's. Both token variables default to "" in cfg.py,
# so a missing one is not an import error — it is a bot that starts and then fails to
# authenticate, which is a slower thing to diagnose on this CPU.
DISCORD_TOKEN_BEACON=put_the_test_beacon_token_here
# Only needed if you `dd-ctl deploy anchor`. One .env serves both bots, so it is fine to
# carry both tokens.
DISCORD_TOKEN_ANCHOR=put_the_test_anchor_token_here

# Comma-separated guild ids. Non-"false" marks this as a test environment: commands
# register to these guilds instead of globally (so changes appear immediately) and the
# testing extension loads. This is the variable that makes this box a TEST deployment;
# leaving it unset points a test bot at global command registration.
TEST_ENV=1000000000000000000

# Whether the bot disables mirror destinations it cannot post to. Defaults false.
DISABLE_BAD_CHANNELS=True


# =================================================================================
# 6. Discord — control server and channels
# =================================================================================
# Defaults exist (-1 / 0) but they mean "no control server" and "no logging", which is
# a bot that ignores its owner commands and reports nothing. Use the TEST guild's ids.
CONTROL_DISCORD_SERVER_ID=1000000000000000000
CONTROL_DISCORD_ROLE_ID=1000000000000000000
KYBER_DISCORD_SERVER_ID=1000000000000000000
LOG_CHANNEL_ID=1000000000000000000
ALERTS_CHANNEL_ID=1000000000000000000

# Minimum level forwarded to ALERTS_CHANNEL_ID. Defaults to ERROR.
ALERT_MIN_LEVEL=ERROR


# =================================================================================
# 7. Discord — constants and followables
# =================================================================================
# Parsed as hex (int(x, 16)); default "0" is plain black.
EMBED_DEFAULT_COLOR=0xEC42A5
EMBED_ERROR_COLOR=0xEF323F

# JSON. Each key is a followable (anchor-posted, beacon-mirrored) announce channel id.
# Defaults to {}, which loads no autoposts at all. A key set to 0 leaves that feed
# dormant — that is how portal_ops and iron_banner ship. These are the PRODUCTION ids
# from the app repo's .env-example; for a test deploy, replace them with channel ids in
# your test guild, or leave the ones you do not exercise at 0.
FOLLOWABLES='{"ada": 0, "twab": 0, "prime": 0, "nwid": 0, "lost_sector": 0, "daily_reset": 0, "eververse": 0, "weekly_reset": 0, "trials": 0, "xur": 0, "portal_ops": 0, "iron_banner": 0}'

# Fallback link used in embeds. Defaults to "".
DEFAULT_URL="https://kyberscorner.com/"


# =================================================================================
# 8. Migrations
# =================================================================================
# Each bot runs `alembic upgrade head` itself on startup, before it touches a table —
# supervisord has no dependency ordering, so the migration is sequenced by straight-line
# Python instead of by an entrypoint. Defaults true, and true is what you want here:
# nothing else on this box migrates the database. On a first cold start this replays
# every migration on a 700 MHz core; budget minutes, not seconds.
RUN_MIGRATIONS_ON_STARTUP=true


# =================================================================================
# 9. Memory
# =================================================================================
# OOM-kill preference the BOT PROCESS raises itself to at startup (-1000..1000; unset
# leaves the container default). Direction matters: Linux always lets a process raise
# its own /proc/self/oom_score_adj, but lowering it needs CAP_SYS_RESOURCE, which
# rootless podman cannot grant. So the container baseline stays at 0 — protecting
# supervisord and the break-glass sshd, which cannot be protected after the fact — and
# the bot pushes itself up, so the kernel reaps the bot first if this 512 MB box runs
# out. This is why compose.yaml carries no `oom_score_adj:` key: that would raise the
# whole container, supervisor and sshd included, irreversibly.
OOM_SCORE_ADJ=800


# =================================================================================
# 10. Break-glass sshd inside the container
# =================================================================================
# ARMS the in-container sshd (port 2222, non-root, inside the container's network
# namespace). sshd runs either way; this variable is copied into its authorized_keys at
# every start, so UNSET (or empty) means an empty file, which means every login is
# refused — password auth is off, so there is no other way in. That is the disarmed
# default, and it is the right default.
#
# One public key only: a dotenv file cannot express more than one line. compose.yaml
# does not publish port 2222 — reach it with `podman exec` unless you have a reason to
# expose an sshd on the network this box sits on.
#
# Purpose: a shell in a container whose bot has gone FATAL. supervisord outlives the
# bot, so the container is still there to get into.
# SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA...replace_with_your_public_key... you@yourbox


# =================================================================================
# 11. Anchor only — the web UI and Bungie
# =================================================================================
# All of these default to "" in cfg.py and are deliberately NOT part of import-time
# validation, so beacon deploys and local dev are unaffected by leaving them blank. They
# only matter if you `dd-ctl deploy anchor` and want the web surface to work.

# Webserver port inside the container. Defaults to 8080. compose.yaml does not publish
# it; see the commented `ports:` block there.
PORT=8080

# Public origin the anchor web app is reachable at, used to mint rotation-editor links
# and as the OAuth redirect base. Scheme required, no trailing slash. Leave unset unless
# you actually publish 8080 and front it with a tunnel — an unset value makes the
# rotation-editor command surface a clear error instead of minting a dead link.
# PUBLIC_BASE_URL=https://anchor-two.example.com

# Bungie API credentials (developer portal). Needed for the manifest download and the
# OAuth flow. NOTE: anchor downloads and indexes the Destiny manifest; that is a heavy
# job for a 512 MB armv6 board — expect it to be the thing that makes anchor unhappy
# here, not the bot itself.
BUNGIE_API_KEY=""
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=""

# Discord OAuth for the anchor web UI. CLIENT_ID is the application id; CLIENT_SECRET
# comes from the Developer Portal's OAuth2 tab and is NOT the bot token. Register
# {PUBLIC_BASE_URL}/auth/callback under Portal -> OAuth2 -> Redirects.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=""

# Dev-only auth bypass: a Discord user id treated as an authenticated owner for the web
# UI. Honoured ONLY when TEST_ENV is set AND PUBLIC_BASE_URL is empty, so it is inert on
# anything internet-facing. TEST_ENV *is* set on this box, so if you also leave
# PUBLIC_BASE_URL unset this bypass is LIVE for anyone who can reach port 8080 —
# which, as shipped, is nobody, because the port is not published. Leave it unset unless
# you are deliberately testing the editors without an OAuth round trip.
# DEV_AUTH_USER_ID=1000000000000000000


# =================================================================================
# 12. Variables that exist in the app repo's .env-example but do NOT belong here
# =================================================================================
# Listed so their absence is visible as a decision rather than an omission.
#
#   DEV_SSH_AUTHORIZED_KEYS, DEV_SSH_PORT, DEV_MEM_LIMIT, DEV_MEMSWAP_LIMIT
#       The Pi 5 dev-container setup (docker-compose.dev.yml). Nothing on `two` runs it.
#   DEVBOT_SCHEMA, DEVBOT_OOM_SCORE_ADJ, DEVBOT_JEMALLOC
#       The spin-up-to-test dev-bot runner. Not used by a container deploy.
#   RAILWAY_PUBLIC_DOMAIN
#       Injected by Railway; PUBLIC_BASE_URL is the override to use here.
#   SRC_ROOT
#       Every other stack in this repo needs it for a build context. This one builds
#       nothing — the image comes prebuilt from GHCR — so there is no source root and
#       nothing here for bin/check-sources to compare against. SOURCE still records the
#       upstream URL, with no sha; check-sources reports that as `registry-deployed`
#       rather than as drift. See SOURCE for the reasoning.
