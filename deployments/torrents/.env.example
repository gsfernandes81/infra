# deployments/torrents/.env.example — committed. Copy to .env and fill in.
# .env is gitignored and holds live ProtonVPN credentials.

# ProtonVPN OpenVPN credentials.
# These are the OpenVPN/IKEv2 credentials from the Proton account page, NOT the
# Proton account login. The username needs the "+pmp" suffix for port forwarding.
OPENVPN_USER=
OPENVPN_PASSWORD=

# Unused: this stack runs VPN_TYPE=openvpn. Kept because a key is provisioned on the
# Proton account, so it is a live secret and must stay out of git even while unused.
# Switching to WireGuard is not planned.
WIREGUARD_PRIVATE_KEY=
