# deployments/garmin-mcp/.env on `one` — never copied by hand. Every line is written by
# ansible/playbooks/server-deploy-garmin-mcp.yml, which creates the file at 0600 through
# its stack-tunnel half. Listed here so the file is readable; every one is ${VAR:?} in
# compose.yaml, so a missing line stops Compose with its name.

# Where the source checkouts live on this host (the play: <ssh user's home>/src). The
# checkout is $SRC_ROOT/garmin-mcp, the name bin/check-sources looks for.
# SRC_ROOT=

# https://garmin-mcp.<dns_zone>. The OAuth metadata uses it instead of trusting the
# request's Host header.
# PUBLIC_BASE_URL=

# SECRETS, generated by the play and never printed. The consent secret is the one you type
# on claude.ai's consent page: it lives on the phone, in ~/.config/garmin-mcp/consent-secret,
# and is copied here on every run. The bearer token is generated here once and seen by
# nobody but the OAuth shim and claude.ai. Rotation: delete the phone file (consent) or
# this line (bearer), re-run the play, reconnect the connector.
# MCP_CONSENT_SECRET=
# MCP_BEARER_TOKEN=

# WRITTEN BY the stack-tunnel half of the play: the tunnel's id, and where its credentials
# are (outside this checkout, 65532:65532 0600). A re-run rewrites both lines.
# TUNNEL_ID=
# TUNNEL_CREDENTIALS=

# NO GARMIN_EMAIL AND NO GARMIN_PASSWORD, although upstream's README says to put them here.
# The one-time login (README.md beside this) prompts for both and reads the password with
# getpass, so it never touches a file. Upstream's server, finding a password in its
# environment, would log in with it silently whenever its tokens failed, and write a
# base64 copy of the tokens beside them. compose.yaml would not pass either line to the
# container anyway (its environment is explicit), and the play refuses to run while
# either is in this file.
