# deployments/immich/.env.example — committed. Copy to .env and fill in.
# .env is gitignored and holds the live Postgres password.

# Where the library and the database live. Both are btrfs subvolumes on the RAID1
# array. They are NOT interchangeable and must not be set to the same path — that
# was the pre-2026-01 layout, and untangling it left a stray Postgres cluster inside
# the library directory for seven months.
#
# The bare mountpoints underneath these paths are `chattr +i`. If the array fails to
# mount, writes here fail with EPERM instead of Immich creating a blank library and
# Postgres initdb'ing over nothing. See bin/check-mount-guards.
UPLOAD_LOCATION=/media/immich-data
DB_DATA_LOCATION=/media/immich-db

TZ=Etc/UTC

# Pinned, never `latest` — a restart at 03:00 must not deploy a new major version.
IMMICH_VERSION=v3

DB_PASSWORD=something_something
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
