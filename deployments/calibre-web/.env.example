# Copy to .env on `one` and fill in. Host-specific values only; never $HOME (CLAUDE.md).
# Every one is ${VAR:?} in compose.yaml, so a missing line stops Compose with its name.

# The uid/gid that owns the library and the config subvolume. `id gavin` on one.
PUID=
PGID=
TZ=Europe/London

# The two subvolumes, mounted by fstab — README.md § Storage.
CALIBRE_LIBRARY=/media/calibre-library
CALIBRE_CONFIG=/media/calibre-web-config

# WRITTEN BY ansible/playbooks/server-create-stack-tunnel.yml -e stack=calibre-web, never
# by hand: the id of the tunnel it made, and where it put that tunnel's credentials
# (outside this checkout, 65532:65532 0600). A re-run rewrites both lines and nothing else.
# TUNNEL_ID=
# TUNNEL_CREDENTIALS=
