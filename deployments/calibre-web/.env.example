# Copy to .env on `one` BEFORE running the play (README step 1: `cp -n`), and fill in.
# The play appends the two TUNNEL_ lines below to it; a copy made after the play would
# replace them. Host-specific values only; never $HOME (CLAUDE.md). Every one is ${VAR:?}
# in compose.yaml, so a missing line stops Compose with its name.

# The uid/gid that owns the library and the config subvolume. `id gavin` on one.
PUID=
PGID=
TZ=Europe/London

# The two subvolumes, media-calibre-library and media-calibre-config, mounted by fstab —
# README.md step 2.
CALIBRE_LIBRARY=/media/calibre/library
CALIBRE_CONFIG=/media/calibre/config

# WRITTEN BY ansible/playbooks/server-create-stack-tunnel.yml -e stack=calibre-web, never
# by hand, and only once its probe has proved the Access login is in front: the id of the
# tunnel it made, and where it put that tunnel's credentials (outside this checkout,
# 65532:65532 0600). Until then compose refuses to start. A re-run rewrites both lines.
# TUNNEL_ID=
# TUNNEL_CREDENTIALS=
