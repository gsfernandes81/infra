# deployments/ionic-traces/.env.example — committed. Copy to .env and fill in.
# .env is gitignored and holds the live Discord token and MySQL root password.

# Where the source checkouts live on this host. Used for build.context.
# Deliberately blank: this is per-host, and leaving it empty keeps any particular
# user's home directory out of git. Fill it in in .env (e.g. /home/<user>/src).
# ':?' in the compose file means an unset value stops Compose with an error rather
# than silently building from the wrong path.
SRC_ROOT=

ADMINS=<discord_user_ids>
APP_URL=http://example.com
DISCORD_TOKEN=something_something
HTTPS_ENABLED=True
MYSQL_HOSTNAME=something_something
MYSQL_PORT=<123456>
MYSQL_DATABASE=ionic
MYSQL_ROOT_PASSWORD=something_something
MYSQL_URL=mysql://root:${MYSQL_ROOT_PASSWORD}@${MYSQL_HOSTNAME}:${MYSQL_PORT}/${MYSQL_DATABASE}
MYSQL_SSL=false
PIZZA_SERVER_LIST=<list_of_servers_where_joke_features_are_enabled>
PORT=7777
PYTHONUNBUFFERED=1 # Run for local testing to make logging more timely, but not production
