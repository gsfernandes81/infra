#!/usr/bin/env python3
# Install ONE tracked /etc copy onto this host, from the repo, with verification.
#
# This does the reversible half of a change and nothing else. It writes a file, sets
# its mode, and validates the result. It NEVER starts, stops, restarts or reloads a
# service -- that separation is the whole safety argument. CLAUDE.md already requires
# splitting `prepare` (reversible, no restart) from `restart` (risky, needs a watched
# rollback); this program is structurally incapable of the second half, so using it
# cannot skip that discipline. Activating what you installed stays a human step.
#
# It also does not GENERATE anything. The bytes that land in /etc are the bytes in the
# repo, which are the bytes you reviewed in a diff. Generating boot-path content from
# templates was considered and rejected, and still is; copying a reviewed, tracked,
# byte-identical file is a different thing and is what this does.
#
# Deliberate restrictions, each one closing a failure this repo has actually seen:
#
#   - Dry run by default. --commit is required to write anything.
#   - ONE file per invocation. There is no --all: a bug here must not be able to
#     rewrite every boot-path file on the box in one go.
#   - Backups go OUTSIDE /etc/init.d. OpenRC treats every file in that directory as a
#     service, so a backup left there lands in the dependency tree -- which happened on
#     2026-08-03 with bcache-register.bak-20260803.
#   - A content change beyond the infra- header needs --allow-content-change, so
#     "just adding a comment" can never be cover for smuggling a real edit onto the
#     boot path.
#   - A sudoers file must pass visudo BEFORE it is written: one bad file in
#     /etc/sudoers.d stops sudo altogether, and with it the rollback below.
#   - Post-install validation is type-aware, and a failure rolls back automatically.
#     The rollback is then VERIFIED, and reported separately from the thing that
#     triggered it -- an uncalibrated check once reported a good system as broken and
#     then claimed its own rollback had failed too.
#
# usage: bin/install-system-file <name> [--commit] [--allow-content-change] [--new]
#        bin/install-system-file --list
# exit 0 = installed (or dry run clean)   1 = refused, failed, or rolled back
#
# --list prints the repo path of every file this host's copy would accept, one per line,
# and writes nothing. server-install-system-files.yml asks it rather than finding the files
# itself, so the play and the tool cannot disagree about which directory is this host's
# (system/ on Alpine, leap/system/ once hosts/<host>/leap/MOVED says it runs Leap).

import argparse
import os
import re
import shlex
import shutil
import subprocess
import stat
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _infra import (  # noqa: E402
    REPO, fs_type, host_init_system, live_path, mode_is_settable, parse_header,
    strip_header, system_dir, this_host, tracked_files,
)

BACKUP_ROOT = Path.home() / ".infra-backups"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def read_bytes(path):
    """Read a file, falling back to sudo for root-only ones."""
    try:
        return path.read_bytes()
    except PermissionError:
        out = subprocess.run(["sudo", "cat", str(path)], capture_output=True)
        if out.returncode != 0:
            raise
        return out.stdout


def live_exists(path):
    """Whether `path` exists, falling back to sudo for a root-only directory.

    Path.exists() raises PermissionError on EACCES rather than answering, so an
    unprivileged dry run of a file in /etc/sudoers.d (0750 on Leap and Alpine) crashed
    before it showed anything: microos-sim's rename of three found it, with the dry run of
    sudoers-restore ending the install loop. sudo answers as root would.

    It asks for a yes or a no, so a sudo that fails (no TTY, a wrong password) stops
    the run instead of reading as "not there", which would show an existing file as new.
    """
    try:
        return path.exists()
    except PermissionError:
        out = run(["sudo", "sh", "-c", 'if [ -e "$1" ]; then echo yes; else echo no; fi',
                   "sh", str(path)])
        answer = out.stdout.strip()
        if out.returncode != 0 or answer not in ("yes", "no"):
            print(f"cannot read {path}: sudo failed: {out.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        return answer == "yes"


def live_mode(path):
    """The permission bits of `path`, falling back to sudo, for the same reason."""
    try:
        return stat.S_IMODE(path.stat().st_mode)
    except PermissionError:
        # -L, as Path.stat() follows a symlink.
        out = run(["sudo", "stat", "-L", "-c", "%a", str(path)])
        if out.returncode != 0:
            raise
        return int(out.stdout.strip(), 8)


def write_modeless(data, live):
    """Write `live` on a filesystem with no Unix modes (vfat): dd into a new file beside
    it, then rename over it. `install -o -g -m` and `cp -a` both chmod, which FAT refuses
    with EPERM unless the mode asked for is the one the mount already gives, so they fail
    on a mount whose fmask they do not match. dd only creates and writes, and the rename
    keeps the old file whole until the new one is complete. The temporary name is not
    one the Pi's firmware reads."""
    tmp = live.with_name(f".{live.name}.infra-new")
    out = subprocess.run(["sudo", "dd", f"of={tmp}", "status=none", "conv=fsync"],
                         input=data, capture_output=True)
    if out.returncode == 0:
        out = subprocess.run(["sudo", "mv", "-f", str(tmp), str(live)], capture_output=True)
    if out.returncode != 0:
        run(["sudo", "rm", "-f", str(tmp)])
    return out.returncode == 0, out.stderr.decode(errors="replace").strip()


def validate_openrc_script(path):
    """A syntax error here is a service that cannot start at boot."""
    out = run(["sh", "-n", str(path)])
    if out.returncode != 0:
        return [f"shell syntax error in {path}: {out.stderr.strip()}"]
    return []


def known_uuids():
    """Every filesystem uuid this box can currently name, lowercased.

    TWO sources, and the second is not optional. /dev/disk/by-uuid alone is WRONG
    here: on `zero` it holds only the three bcache COMPONENT uuids (the ones
    bcache-register registers) plus root, boot and swap. The btrfs FILESYSTEM uuid
    813c830a-... never gets a symlink, because the array assembles through btrfs-scan
    from /dev/bcache0 and /dev/bcache1, not through mdev -- so the live, mounted,
    working array reads as "does not resolve" on the symlink test alone. That is a
    check failing against known-good state, which CLAUDE.md says to calibrate for
    before trusting any verdict.

    Rejected alternatives:
      - blkid: unprivileged, `blkid -U` exits 0 with NO output for a real uuid and a
        nonsense one alike. It cannot distinguish them without root.
      - "is the mountpoint mounted": passes for the wrong reason. Every entry on a
        running box is mounted, so a typo'd uuid on / would read clean.

    /sys/fs/btrfs/<fs-uuid>/ is the kernel's own registry of assembled btrfs
    filesystems, it is readable unprivileged, and it names the multi-device case
    correctly.
    """
    found = set()
    for source in (Path("/dev/disk/by-uuid"), Path("/sys/fs/btrfs")):
        try:
            found.update(p.name.lower() for p in source.iterdir())
        except OSError:
            pass
    found.discard("features")  # /sys/fs/btrfs holds this alongside the uuids
    return found


def validate_fstab(path):
    """The file that decides whether this box comes back after a reboot.

    Every entry has six fields, and every UUID= it names resolves to something. A
    typo'd UUID is invisible until the reboot it strands you on.
    """
    problems = []
    data = read_bytes(path).decode(errors="replace")
    known = known_uuids()

    for lineno, line in enumerate(data.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split()
        if len(fields) != 6:
            problems.append(f"{path}:{lineno}: {len(fields)} fields, expected 6")
            continue

        spec, mountpoint, _fstype, opts, _dump, _passno = fields
        m = re.match(r"^UUID=(.+)$", spec)
        if not m:
            continue

        options = opts.split(",")
        # noauto entries are deliberately absent -- cdrom and usb are the archetype,
        # and /mnt/ext is the same idea. Nothing to verify.
        if "noauto" in options:
            continue

        if m.group(1).lower() not in known:
            note = ("carries nofail, so boot survives it"
                    if "nofail" in options
                    else "NO nofail -- this can stall or fail the boot")
            problems.append(
                f"{path}:{lineno}: UUID {m.group(1)} for {mountpoint} matches no "
                f"block device or btrfs filesystem on this host ({note})"
            )
    return problems


def validate_sshd_config(path):
    """`sshd -t` on the file, and on the combined config it becomes part of.

    This is the tracked file where being wrong costs most: a bad one means no NEW
    logins on a remote box. Existing sessions survive it -- sshd only re-reads on
    restart, and a restart that fails leaves the running daemon alone -- so it is not
    instantly fatal, but it is discovered at the worst possible moment.

    TWO CHECKS, because a drop-in can be valid alone and wrong in place.
    /etc/ssh/sshd_config carries `Include sshd_config.d/*.conf`, so testing the main
    file tests the combination. Pre-install that is a CALIBRATION -- if the config
    already running cannot pass `sshd -t`, this checker is not a verdict on anything,
    and refusing on that basis would block a good change (the mount-guard socket count
    did exactly that once, and then reported its own rollback as failed). Post-install
    the same command tests the candidate for real, because by then it is included.

    The two are told apart by where the file is: under /etc it is live.

    Runs under sudo -- sshd reads host keys, and as a normal user it fails for reasons
    that have nothing to do with the file being checked.
    """
    problems = []
    sshd = "/usr/sbin/sshd"
    if not Path(sshd).exists():
        return [f"{sshd} not found -- cannot validate an sshd config on this host"]

    installed = str(path).startswith("/etc/ssh/")

    r = run(["sudo", sshd, "-t", "-f", str(path)])
    if r.returncode != 0:
        for line in (r.stderr or r.stdout).splitlines():
            problems.append(f"sshd -t on this file: {line}")
        if not problems:
            problems.append(f"sshd -t exited {r.returncode} with no message")

    main = Path("/etc/ssh/sshd_config")
    if main.exists():
        c = run(["sudo", sshd, "-t", "-f", str(main)])
        if c.returncode != 0:
            detail = (c.stderr or c.stdout).strip()
            if installed:
                problems.append(
                    "the COMBINED config now fails `sshd -t`, so this file is valid "
                    "alone but wrong in place: " + detail
                )
            else:
                problems.append(
                    "the LIVE /etc/ssh/sshd_config does not pass `sshd -t` already, so "
                    "this check cannot be a verdict on the candidate. Investigate that "
                    "first, and do not read this as the new file being at fault: "
                    + detail
                )
    return problems


def validate_sudoers(path):
    """`visudo -cf` on the file: sudo's own parser, which reads it as sudo will.

    This one has to pass BEFORE the write, and the pre-check on the repo copy is the check
    that counts. sudo reads every file in /etc/sudoers.d on every run and refuses to run
    at all over one it cannot parse, so a bad file installed is a box where `sudo` no
    longer works: the post-install check, and the rollback, both need sudo and would fail
    with it. On zero, remote, that would leave no way to elevate but a console.

    With -f, visudo checks the syntax of the file it is given and not its owner or mode,
    so the repo copy (gavin's, 0644) and the live file (root's, 0440) read the same.
    Calibrated by sim/alpine/run-setup-plays.sh on Alpine: the live /etc/sudoers.d/gavin
    reads `parsed OK`, zero's sudoers-backup passes, and a broken copy of it is refused.
    """
    visudo = "/usr/sbin/visudo"
    if not Path(visudo).exists():
        return [f"{visudo} not found -- cannot validate a sudoers file on this host"]
    r = run(["sudo", visudo, "-cf", str(path)])
    if r.returncode == 0:
        return []
    lines = (r.stderr + r.stdout).strip().splitlines()
    return [f"visudo -cf: {ln}" for ln in lines] or [f"visudo -cf exited {r.returncode}"]


def parse_dmcrypt_conf(data):
    """The entries of a /etc/conf.d/dmcrypt, read the way cryptsetup-openrc's
    /etc/init.d/dmcrypt reads them: one line at a time, comments, blank lines, rc_* and
    dmcrypt_* lines skipped, and target= or swap= starting a new entry. Returns a list of
    (line number, {key: value}) and a list of problems."""
    entries, problems = [], []
    known = ("target", "swap", "source", "key", "remdev", "gpg_options", "loop_file",
             "options", "pre_mount", "post_mount")
    for lineno, line in enumerate(data.splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        name, sep, value = stripped.partition("=")
        if not sep:
            problems.append(f"line {lineno}: not a name=value line, which dmcrypt skips")
            continue
        if name.startswith("rc_") or name.startswith("dmcrypt_"):
            continue
        if name not in known:
            problems.append(f"line {lineno}: {name}= is not a setting dmcrypt reads; it would skip the line")
            continue
        try:
            words = shlex.split(value)
        except ValueError as exc:
            problems.append(f"line {lineno}: {exc}")
            continue
        value = words[0] if len(words) == 1 else " ".join(words)
        if name in ("target", "swap"):
            entries.append((lineno, {name: value}))
        elif not entries:
            problems.append(f"line {lineno}: {name}= outside an entry, which dmcrypt ignores")
        else:
            entries[-1][1][name] = value
    return entries, problems


def validate_dmcrypt_conf(path):
    """Every entry opens, unattended, with what is on this box now.

    An entry the boot cannot open costs a mount, which nofail and the immutable
    mountpoints absorb. An entry that ASKS costs the boot: dmcrypt runs cryptsetup with
    no timeout, at a console nobody watches. So each entry must name a key file, the key
    file must be root's alone, the source must resolve the way dmcrypt resolves it
    (findfs), and the key must open it -- `cryptsetup open --test-passphrase`, which
    reads the key and maps nothing. A placeholder left by the repo is refused first.

    Calibrated in sim/alpine/run-dmcrypt.sh against a real LUKS2 volume on a loop device:
    the good entry passes, and each of the refusals below is shown refusing.
    """
    problems = []
    data = read_bytes(path).decode(errors="replace")
    for lineno, line in enumerate(data.splitlines(), 1):
        if "FILL-FROM-" in line and not line.lstrip().startswith("#"):
            problems.append(f"line {lineno}: a FILL-FROM- placeholder is left in: {line.strip()}")
    if problems:
        return problems
    r = run(["sh", "-n", str(path)])
    if r.returncode != 0:
        return [f"shell syntax error: {r.stderr.strip()}"]

    entries, problems = parse_dmcrypt_conf(data)
    if problems:
        return problems
    cryptsetup = shutil.which("cryptsetup") or "/sbin/cryptsetup"
    if entries and not Path(cryptsetup).exists():
        return ["cryptsetup is not installed (apk add cryptsetup cryptsetup-openrc)"]

    for lineno, e in entries:
        label = f"entry at line {lineno} ({e.get('target') or e.get('swap')})"
        if "swap" in e:
            continue  # a swap entry makes a new random key every boot; nothing to check
        key, source = e.get("key"), e.get("source")
        if not key:
            problems.append(f"{label}: no key=, so dmcrypt would ask at the console and the boot would wait")
            continue
        if ":" in key or e.get("remdev") or e.get("loop_file"):
            problems.append(f"{label}: only a plain key file on this box is supported here")
            continue
        if not source:
            problems.append(f"{label}: no source=")
            continue
        if not key.startswith("/etc/"):
            # dmcrypt runs in the boot runlevel before localmount, so the key must be on the
            # root filesystem, which on zero holds /etc.
            problems.append(f"{label}: key file {key} is outside /etc, so it may not be mounted when dmcrypt runs")
            continue

        st = run(["sudo", "stat", "-c", "%u %a", key])
        if st.returncode != 0:
            problems.append(f"{label}: cannot read key file {key}: {st.stderr.strip() or 'no such file'}")
            continue
        uid, mode = st.stdout.split()
        if uid != "0" or int(mode, 8) & 0o077:
            problems.append(f"{label}: key file {key} is uid {uid} mode {mode}; it must be root's, 0400 or 0600")
            continue

        if "=" in source:
            # findfs is what dmcrypt itself runs, so this is the boot's own answer.
            f = run(["sudo", "findfs", source])
            dev = f.stdout.strip()
            if f.returncode != 0 or not dev:
                problems.append(f"{label}: findfs {source} finds no device")
                continue
        else:
            dev = source
        if run(["sudo", cryptsetup, "isLuks", dev]).returncode != 0:
            problems.append(f"{label}: {dev} is not a LUKS volume")
            continue
        t = run(["sudo", cryptsetup, "open", "--test-passphrase", "--key-file", key, dev])
        if t.returncode != 0:
            problems.append(f"{label}: the key file does not open {dev}: {t.stderr.strip()}")
    return problems


def validators_for(live):
    v = []
    if live.parent == Path("/etc/sudoers.d") or live == Path("/etc/sudoers"):
        v.append(validate_sudoers)
    if live.parent == Path("/etc/init.d"):
        v.append(validate_openrc_script)
    if live.name == "fstab":
        v.append(validate_fstab)
    if live == Path("/etc/conf.d/dmcrypt"):
        v.append(validate_dmcrypt_conf)
    # The main file, and any drop-in the Include pulls in.
    if live.name == "sshd_config" or live.parent == Path("/etc/ssh/sshd_config.d"):
        v.append(validate_sshd_config)
    return v


def main():
    ap = argparse.ArgumentParser(
        description="Install one tracked /etc copy onto this host.",
    )
    ap.add_argument("name", nargs="?",
                    help="filename under this host's system/ (leap/system/ on Leap)")
    ap.add_argument("--list", action="store_true",
                    help="print the tracked files this host would accept, and write nothing")
    ap.add_argument("--commit", action="store_true",
                    help="actually write (default is a dry run)")
    ap.add_argument("--allow-content-change", action="store_true",
                    help="permit changes beyond the infra- header")
    ap.add_argument("--new", action="store_true",
                    help="permit creating a file that does not exist yet")
    args = ap.parse_args()

    host = this_host()
    if args.list:
        if args.name or args.commit or args.allow_content_change or args.new:
            ap.error("--list takes no file name and no other option")
        tracked = tracked_files(host)
        if tracked is None:
            print(f"no tracked files: {system_dir(host)} does not exist", file=sys.stderr)
            return 1
        for p in tracked:
            print(p.relative_to(REPO))
        return 0
    if not args.name:
        ap.error("name a tracked file, or pass --list")
    entry = system_dir(host) / args.name
    if not entry.is_file():
        print(f"no tracked file {entry}", file=sys.stderr)
        return 1

    meta, err = parse_header(entry)
    if err:
        print(f"{args.name}: {err}", file=sys.stderr)
        return 1

    live = live_path(meta)
    want_mode = int(meta["mode"], 8)

    running = host_init_system()
    if running and meta["init"] != running:
        print(
            f"refusing: {args.name} declares init={meta['init']} but this host runs "
            f"{running}",
            file=sys.stderr,
        )
        return 1

    repo_bytes = entry.read_bytes()
    exists = live_exists(live)

    if not exists and not args.new:
        print(
            f"refusing: {live} does not exist. If you mean to create it, pass --new.",
            file=sys.stderr,
        )
        return 1

    print(f"host:    {host}")
    print(f"source:  {entry}")
    # Calibrated on every mount of a running box against `findmnt --target`, and on a Pi's
    # mount table, where /boot/efi is vfat and /usr/local and /etc are btrfs.
    modeless = not mode_is_settable(live)
    if modeless:
        print(f"target:  {live}  (on {fs_type(live)}: the mount decides its mode, "
              f"which is neither set nor checked)")
    else:
        print(f"target:  {live}  (mode {want_mode:04o})")

    if exists:
        # Show a mode CHANGE before it happens, not after. `install -m` applies the
        # header's mode unconditionally, so a header written for another host -- or
        # guessed -- silently re-permissions a live file, and a plain diff cannot see it.
        current_mode = live_mode(live)
        if modeless:
            current_mode = want_mode  # the mount's fmask, not the file's: never a change
        if current_mode != want_mode:
            print(
                f"mode:    {current_mode:04o} -> {want_mode:04o}  "
                f"** THIS CHANGES PERMISSIONS ** — if {want_mode:04o} is wrong, fix "
                f"infra-mode in the repo copy rather than installing this"
            )

        live_bytes = read_bytes(live)
        if live_bytes == repo_bytes and current_mode == want_mode:
            print("\nalready identical, including the header. Nothing to do.")
            return 0

        if live_bytes == repo_bytes:
            # Bytes match but the mode does not: fall through to the install, which
            # applies the header's mode without changing a byte. Before 2026-08-24
            # this path returned early on bytes alone -- the tool warned about the
            # mode above and then declared nothing to do, so a 0755
            # credential-adjacent file (the cloudflared.bak-token incident class)
            # could never be fixed by the tool that exists to fix exactly that. This
            # branch must never print "Nothing to do." -- the Ansible play
            # string-matches it to decide what to skip.
            print("\nchange:  MODE ONLY -- bytes are identical")
        else:
            header_only = strip_header(repo_bytes) == live_bytes
            print(f"\nchange:  {'header only' if header_only else 'CONTENT CHANGE'}")

            diff = run(["diff", "-u", "--label", str(live), "--label", str(entry),
                        "/dev/stdin", str(entry)],
                       input=live_bytes.decode(errors="replace"))
            print("".join(f"    {ln}\n" for ln in diff.stdout.splitlines()))

            if not header_only and not args.allow_content_change:
                print(
                    "refusing: this changes more than the infra- header. Re-read the "
                    "diff above, then pass --allow-content-change if it is what you "
                    "intend.",
                    file=sys.stderr,
                )
                return 1
    else:
        print("\nchange:  CREATING a new file")

    for check in validators_for(live):
        problems = check(entry)
        if problems:
            print(f"\nrefusing: the repo copy fails {check.__name__}:", file=sys.stderr)
            for p in problems:
                print(f"  {p}", file=sys.stderr)
            return 1
    print("pre-checks on the repo copy: ok")

    if not args.commit:
        print("\nDRY RUN. Nothing was written. Re-run with --commit to apply.")
        if live.parent == Path("/etc/init.d"):
            print("Note: installing a service file does NOT start or restart it.")
        return 0

    # ---- from here on we write ----
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup_dir = BACKUP_ROOT / host / stamp
    backup = backup_dir / meta["name"]
    backup_dir.mkdir(parents=True, exist_ok=True)

    if exists:
        out = run(["sudo", "cp", "-a", str(live), str(backup)])
        if out.returncode != 0:
            print(f"\nbackup failed, nothing written: {out.stderr.strip()}",
                  file=sys.stderr)
            return 1
        print(f"\nbacked up {live} -> {backup}")

    if modeless:
        ok, err = write_modeless(repo_bytes, live)
    else:
        out = run(["sudo", "install", "-o", "root", "-g", "root",
                   "-m", meta["mode"], str(entry), str(live)])
        ok, err = out.returncode == 0, out.stderr.strip()
    if not ok:
        print(f"install failed: {err}", file=sys.stderr)
        return 1
    print(f"installed {live}")

    # ---- verify, and roll back if the box now disagrees with the repo ----
    problems = []
    if read_bytes(live) != repo_bytes:
        problems.append(f"{live} does not match the repo copy after install")
    installed_mode = live_mode(live)
    if installed_mode != want_mode and not modeless:
        problems.append(f"{live} is mode {installed_mode:04o}, header says {want_mode:04o}")
    for check in validators_for(live):
        problems.extend(check(live))

    if problems:
        print("\nPOST-INSTALL CHECK FAILED:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)

        if not exists:
            print(f"  (file was newly created; removing {live})", file=sys.stderr)
            run(["sudo", "rm", "-f", str(live)])
            return 1

        print("rolling back...", file=sys.stderr)
        if modeless:
            ok, _ = write_modeless(read_bytes(backup), live)
        else:
            ok = run(["sudo", "cp", "-a", str(backup), str(live)]).returncode == 0
        restored = ok and read_bytes(live) == read_bytes(backup)
        if restored:
            print(f"ROLLED BACK: {live} restored from {backup}. The box is as it was; "
                  f"the failure above is the thing to fix.", file=sys.stderr)
        else:
            print(f"ROLLBACK FAILED. {live} is in an unknown state. The backup is "
                  f"intact at {backup} -- restore it by hand before rebooting.",
                  file=sys.stderr)
        return 1

    print("post-install checks: ok")

    # A cache rebuild, not a service action: OpenRC needs this to see a changed
    # depend() block. It starts nothing.
    if live.parent == Path("/etc/init.d"):
        run(["sudo", "rc-update", "-u"])
        deptree = Path("/run/openrc/deptree")
        if deptree.exists() and ".bak" in deptree.read_text(errors="replace"):
            print("WARNING: a stale .bak service appears in the OpenRC deptree")
        else:
            print("OpenRC dependency cache rebuilt; no stray .bak services")
        print(f"\n{meta['name']} is installed but NOT restarted. That is deliberate.")

    if live.name == "fstab":
        print("\nfstab changes take effect at the next mount or reboot. "
              "Nothing was remounted.")

    return 0


if __name__ == "__main__":
    sys.exit(main())
