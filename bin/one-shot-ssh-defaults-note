#!/usr/bin/env sh
# usage: sh bin/one-shot-ssh-defaults-note [path-to-ssh-config]
#
# ONE-SHOT. Delete once every client has run it — ../CLAUDE.md, "One-shot migration
# scripts get deleted once run"; git history keeps it.
#
# WHAT IT DOES. Moves the hand-kept "defaults — MUST stay last" note from ABOVE the
# `Host *` block to INSIDE it, indented.
#
# WHY IT HAS TO MOVE. Both client playbooks insert their blocks with
# `insertbefore: '^Host \*\s*$'`, so anything sitting immediately above `Host *` is
# separated from it by the next block they write. On this fleet that has already happened
# once: the note now sits above `# BEGIN infra-fleet` with a hundred-odd lines of
# generated config between it and the four directives it describes. Indented inside the
# block it is unreachable by an insertion, because there is nothing after `Host *` to
# insert before.
#
# It is deliberately NOT the playbook's job. That note is the owner's prose about the
# owner's machine, and a play that rewrites a human's comments owns a file it cannot see.
#
# GENERIC BY CONSTRUCTION. It does not know the note's wording — the phone's and the
# laptop's differ. It finds the line matching "defaults ... MUST stay last" and takes the
# contiguous run of comment lines from there, stopping before the first line that is not a
# comment or that opens a generated block. Byte-count patterns were avoided on purpose:
# the note is drawn with box characters, and `.` in awk matches a BYTE in the C locale
# that Termux and a bare WSL shell both run with, so a dot-count pattern silently matches
# nothing. That bug shipped once already.
#
# HOW IT KNOWS IT DID NO HARM. It records what `ssh -G` resolves for every literal Host in
# the file before and after, and diffs the two. Moving a comment cannot change what ssh
# resolves, so any difference is a bug — and it restores the backup and fails rather than
# leaving you to find out during a rescue. `s24` is excluded: the laptop's config carries
# `Match host s24 exec "adb forward …"`, and ssh evaluates a Match exec WHILE PARSING, so
# asking about that alias would run adb as a side effect of a check.

set -eu

CFG="${1:-$HOME/.ssh/config}"
STAMP=$(date +%Y%m%d-%H%M%S)
# Outside the directory, mode 600 — never a .bak beside the original.
BACKUP="$HOME/ssh-config.pre-defaults-note-$STAMP"
TMP="$HOME/.ssh-defaults-note-$STAMP.tmp"
BEFORE="$HOME/.ssh-G.dn-before-$STAMP"
AFTER="$HOME/.ssh-G.dn-after-$STAMP"

die() { printf '%s\n' "$*" >&2; exit 1; }
trap 'rm -f "$TMP" "$BEFORE" "$AFTER"' EXIT

[ -f "$CFG" ] || die "no ssh config at $CFG"
command -v ssh >/dev/null 2>&1 || die "no ssh on PATH — the verification below needs it"

# Is there a top-level note to move at all?
if ! grep -q '^#.*defaults.*MUST stay last' "$CFG"; then
  printf '%s\n' "Nothing to move — no top-level \"defaults ... MUST stay last\" note in $CFG."
  exit 0
fi

# `Host *` has to be the LAST Host stanza, or appending would land the note inside
# whatever block is actually last and silently attach it to the wrong thing.
LAST_HOST=$(grep -n '^[Hh]ost[ \t]' "$CFG" | tail -1)
case "$LAST_HOST" in
  *:[Hh]ost\ \*|*:[Hh]ost\ \*[\ \t]*) : ;;
  *) die "refusing: the last Host stanza in $CFG is not \`Host *\` but:
    ${LAST_HOST#*:}
  This script appends the note to the end of the file, which is only inside \`Host *\`
  when \`Host *\` is last. Move it there first, or pass a different file." ;;
esac

aliases=$(awk '
  /^[Hh]ost[ \t]/ { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/ && $i != "s24") print $i }
' "$CFG" | sort -u)
[ -n "$aliases" ] || die "found no literal Host aliases in $CFG — refusing to touch it"

snapshot() {
  for a in $aliases; do
    printf -- '--- %s\n' "$a"
    ssh -F "$CFG" -G "$a" 2>&1 || printf 'ssh -G failed\n'
  done
}

cp "$CFG" "$BACKUP"
chmod 600 "$BACKUP"
snapshot > "$BEFORE"

awk '
  { line[NR] = $0 }
  END {
    n = NR
    # the note: from its first line, the contiguous comment run, stopping before the
    # first non-comment line or the first generated-block marker
    for (i = 1; i <= n && !start; i++)
      if (line[i] ~ /^#.*defaults.*MUST stay last/) start = i
    for (i = start; i <= n; i++) {
      if (line[i] !~ /^#/) break
      if (i > start && line[i] ~ /^# (BEGIN|END) /) break
      isnote[i] = 1
      last = i
    }

    for (i = 1; i <= n; i++) {
      if (isnote[i]) continue
      out(line[i])
    }

    # re-indent and append. `Host *` is last (checked by the caller), so the end of the
    # file IS inside its block.
    out("")
    for (i = start; i <= last; i++) {
      s = line[i]
      sub(/^#/, "  #", s)
      print s
    }
    print "  #"
    print "  # INSIDE the block, not above it: both client playbooks insert before"
    print "  # `Host *`, so a note sitting immediately above it is separated from it by"
    print "  # the next block they write. That is how this one drifted."
  }

  # squeeze the hole the note left behind, and drop leading blanks
  function out(s) {
    if (s == "") { if (!seen) return; blank++; return }
    while (blank > 0) { print ""; blank = 0 }
    seen = 1
    print s
  }
' "$CFG" > "$TMP"

[ -s "$TMP" ] || die "the rewrite produced an empty file — $CFG is untouched"

cp "$TMP" "$CFG"
chmod 600 "$CFG"
snapshot > "$AFTER"

if ! diff -u "$BEFORE" "$AFTER" > "$HOME/.ssh-G.dn-diff-$STAMP" 2>&1; then
  cp "$BACKUP" "$CFG"
  chmod 600 "$CFG"
  printf '%s\n' \
    "ROLLED BACK. Moving a comment changed what ssh resolves, which is impossible on" \
    "purpose — so something else is wrong. $CFG is restored, byte-identical." \
    "The difference is in $HOME/.ssh-G.dn-diff-$STAMP — send that, do not re-run." >&2
  exit 1
fi
rm -f "$HOME/.ssh-G.dn-diff-$STAMP"

printf '%s\n' \
  "Moved the defaults note inside \`Host *\` in $CFG." \
  "Verified: \`ssh -G\` resolves identically for every literal Host in the file." \
  "Backup at $BACKUP (mode 600)." \
  "" \
  "Next, and this one is a single line:" \
  "" \
  "  cd ~/infra/ansible && ansible-playbook playbooks/this-client.yml -e prompt_for_token=false"
