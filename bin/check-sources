#!/bin/sh
# Report drift between each stack's pinned SOURCE sha and the real checkout HEAD.
#
# READ-ONLY. This never fetches, never pulls, never checks out. SOURCE records what
# is deployed; keeping it accurate is a deliberate act, not an automatic one.
#
# A SOURCE file has one of two shapes, and the difference is the point:
#
#   <upstream-url> <sha>   PINNED. Built on the host from a checkout. The sha is
#                          compared against that checkout's HEAD; a mismatch, a missing
#                          checkout, a dirty tree and a different remote all report and
#                          all fail.
#   <upstream-url>         REGISTRY-DEPLOYED. Nothing is built and there is no checkout
#                          to compare against — the artefact is a published image, and
#                          which one is running is decided on the host at deploy time,
#                          so no sha belongs here. Reported as such; does NOT affect the
#                          exit status. `destiny-director` is the case: read its SOURCE.
#
# The second shape is a design, not a gap, and it is recognised NARROWLY on purpose:
# exactly one field, and that field must look like a URL. Anything else — two fields
# whose second is not a sha, three fields, a lone sha whose URL was lost to a bad edit
# — is still MALFORMED and still fails. A checker that shrugged at a garbled SOURCE
# would be the wrong-reason pass docs/decisions.md ends on, dressed up as tolerance.
#
# exit 0 = every pin matches   exit 1 = drift or a problem worth looking at
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
rc=0
found=0

for source_file in "$repo"/deployments/*/SOURCE; do
	[ -e "$source_file" ] || continue
	found=1
	stack_dir="$(dirname -- "$source_file")"
	stack="$(basename -- "$stack_dir")"

	# The first line that is neither blank nor a comment is the whole declaration.
	# Split it ONCE, with globbing off and IFS pinned, so a `*` in a URL cannot be
	# expanded against the cwd and a stray tab cannot change what counts as a field.
	line="$(awk '/^[[:space:]]*#/ {next} NF {print; exit}' "$source_file")"
	set -f
	IFS=" $(printf '\t')"
	# shellcheck disable=SC2086  # deliberate, controlled word splitting — see above
	set -- $line
	set +f
	unset IFS
	url="${1:-}"
	pinned="${2:-}"
	third="${3:-}"

	# Field 1 must be a URL under every shape. This is what stops a truncated file
	# whose remaining line is a bare sha from reading as "deliberately unpinned".
	case "$url" in
		https://*|http://*|ssh://*|git@*:*) ;;
		*) url='' ;;
	esac

	if [ -z "$url" ] || [ -n "$third" ]; then
		echo "$stack: MALFORMED SOURCE (want '<url> <sha>', or '<url>' alone)"
		rc=1
		continue
	fi

	if [ -z "$pinned" ]; then
		# No sha, by design. See the header, and the stack's own SOURCE for why.
		# Nothing to verify from here, and nothing here that can be wrong — so this
		# reports and moves on rather than inventing a verdict it has no basis for.
		echo "$stack: registry-deployed  $url"
		echo "    (no sha here by design — a published image, deployed on the host;"
		echo "     ask the host what is running)"
		continue
	fi

	# A pinned sha is hex and nothing else. Without this a garbled second field would
	# reach the comparison below and be reported as DRIFT — loud, but the wrong reason,
	# and it would send you looking at the checkout instead of at this file.
	case "$pinned" in
		*[!0-9a-fA-F]*) pinned='' ;;
	esac
	if [ -z "$pinned" ] || [ "${#pinned}" -lt 7 ] || [ "${#pinned}" -gt 64 ]; then
		echo "$stack: MALFORMED SOURCE (second field is not a sha)"
		rc=1
		continue
	fi

	# SRC_ROOT lives in the stack's gitignored .env, so it is per-host.
	src_root=''
	if [ -f "$stack_dir/.env" ]; then
		src_root="$(sed -n 's/^[[:space:]]*SRC_ROOT[[:space:]]*=[[:space:]]*//p' "$stack_dir/.env" | tail -n1)"
	fi
	if [ -z "$src_root" ]; then
		echo "$stack: SRC_ROOT not set in $stack_dir/.env — cannot locate checkout"
		rc=1
		continue
	fi

	checkout="$src_root/$stack"
	if [ ! -d "$checkout/.git" ]; then
		echo "$stack: no git checkout at $checkout"
		rc=1
		continue
	fi

	head="$(git -C "$checkout" rev-parse HEAD)"
	remote="$(git -C "$checkout" config --get remote.origin.url || echo '')"

	if [ "$head" != "$pinned" ]; then
		echo "$stack: DRIFT"
		echo "    pinned  $pinned"
		echo "    HEAD    $head"
		echo "    (rebuild and update SOURCE, or check out the pinned sha)"
		rc=1
	else
		echo "$stack: ok  ${pinned%"${pinned#???????}"}"
	fi

	if [ -n "$remote" ] && [ "$remote" != "$url" ]; then
		echo "$stack: remote mismatch — SOURCE says $url, checkout says $remote"
		rc=1
	fi

	if [ -n "$(git -C "$checkout" status --porcelain)" ]; then
		echo "$stack: checkout is DIRTY — the deployed image may not match any commit"
		rc=1
	fi
done

if [ "$found" -eq 0 ]; then
	echo "no SOURCE files found under $repo/deployments/"
	exit 1
fi

exit $rc
