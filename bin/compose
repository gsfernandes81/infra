#!/bin/sh
# usage: bin/compose <stack> <args...>     e.g.  bin/compose torrents up -d
#
# Thin wrapper that pins --project-directory to the *resolved* deployments/ path.
# That makes it irrelevant whether you reached the stack via deployments/ or via a
# hosts/<host>/ symlink: the project directory, and therefore every relative path in
# the compose file, is the same answer either way.
#
# THIS RUNS `docker compose`, AND IT STAYS THAT WAY FOR NOW. `two` has no docker at all
# — it runs rootless podman + podman-compose — so the obvious move is to make this
# runtime-aware: probe for `docker compose`, fall back to `podman-compose`. That was
# considered and deferred, because it would not have helped:
#
#   * `two` runs exactly one stack, destiny-director, and that stack cannot be driven
#     from here on ANY host, for a reason that has nothing to do with the runtime — its
#     compose file interpolates two variables (DD_BOT, DD_MALLOC_CONF) with `:?`, and
#     only its own dd-ctl supplies them. A runtime-aware wrapper would
#     have produced a different error message for the same refusal. So this refuses by
#     name, below, and says where to go instead.
#   * The two front-ends are not interchangeable. `docker compose` takes
#     `--project-directory`; `podman-compose` has no such flag and derives the project
#     directory from the compose file's realpath. Here they agree — but for different
#     reasons, and a wrapper that papers over that will eventually paper over a
#     difference that matters.
#
# The bill arrives properly when `one` and `zero` move to podman under MicroOS (see
# docs/roadmap.md), and that is the change to make it at: one deliberate conversion with
# stacks to test it against, not a probe added speculatively for a host that never calls
# this script. Recorded in docs/decisions.md so it is not re-derived.
set -eu

if [ $# -lt 1 ]; then
	echo "usage: ${0##*/} <stack> <args...>" >&2
	echo "stacks:" >&2
	ls -1 "$(dirname -- "$0")/../deployments" >&2
	exit 2
fi

stack=$1
shift

# pwd -P resolves symlinks; the compose file is then addressed through the real path.
dir="$(CDPATH= cd -- "$(dirname -- "$0")/../deployments/$stack" 2>/dev/null && pwd -P)" || {
	echo "${0##*/}: no such stack: $stack" >&2
	exit 2
}

# Stacks this script must not drive. A list, not a category — there is one of them, and
# naming it is greppable in a way a heuristic would not be. Checked AFTER the resolution
# above so a typo'd stack name still gets "no such stack" rather than this.
case "$stack" in
destiny-director)
	cat >&2 <<-EOF
	${0##*/}: refusing to drive $stack — it is not a docker compose stack.

	  Its compose file interpolates DD_BOT and DD_MALLOC_CONF with ':?',
	  and only deployments/destiny-director/dd-ctl supplies them. Running it from here
	  would stop with a missing-variable error at best, and on a host that is not \`two\`
	  it would pull an armv6 image and start a bot against no .env at worst.

	  It runs on \`two\`, which has no docker, and it is deployed over SSH:

	      ssh -i ~/.ssh/dd-ctl gavin@ssh-two.gsrpi.uk status
	      ssh -i ~/.ssh/dd-ctl gavin@ssh-two.gsrpi.uk deploy-beacon

	  See deployments/$stack/dd-ctl and docs/decisions.md.
	EOF
	exit 2
	;;
esac

exec docker compose --project-directory "$dir" -f "$dir/compose.yaml" "$@"
